<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Chat Review — Swapify Admin</title>
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
  <style>
    .chat-bubble { max-width: 70%; padding: 12px 16px; border-radius: 12px; margin-bottom: 12px; }
    .chat-bubble.reporter { background: var(--primary); color: white; align-self: flex-end; border-bottom-right-radius: 4px; }
    .chat-bubble.target { background: var(--muted); color: var(--fg); align-self: flex-start; border-bottom-left-radius: 4px; border: 1px solid var(--border); }
  </style>
</head>
<body>
<%- include('../partials/admin-navbar', { activePage: 'reports' }) %>


  <section class="section" style="padding-top:32px">
    <div class="container" style="max-width:800px">
      <div style="margin-bottom:24px">
        <a href="/admin/reports" class="btn btn-ghost btn-sm" style="margin-bottom:16px; display:inline-block;">&larr; Back to Reports</a>
        <h1 style="font-size:24px;font-weight:700;">Chat Review</h1>
        <p style="color:var(--muted-fg)">Reviewing conversation between <strong><%= report.reporter.username %></strong> (Reporter) and <strong><%= report.reportedUser.username %></strong> (Reported User)</p>
      </div>
      
      <div class="card card-body" style="display:flex; flex-direction:column; background:var(--card); min-height:400px; max-height:600px; overflow-y:auto; padding:24px;">
        <% if (messages && messages.length > 0) { %>
          <% messages.forEach(function(msg) { %>
            <% const isReporter = String(msg.sender._id) === String(report.reporter._id); %>
            <div style="display:flex; flex-direction:column; <%= isReporter ? 'align-items:flex-end;' : 'align-items:flex-start;' %>">
              <span style="font-size:11px; color:var(--muted-fg); margin-bottom:4px;"><%= msg.sender.username %> • <%= new Date(msg.createdAt).toLocaleString() %></span>
              <div class="chat-bubble <%= isReporter ? 'reporter' : 'target' %>">
                <%= msg.text %>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state" style="margin:auto;">
            <div class="empty-state-icon">💬</div>
            <h3>No messages</h3>
            <p>There are no direct messages between these two users.</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <script src="/js/app.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Contact Messages Inbox — Swapify Admin</title>
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
</head>

<body>
  <%- include('../partials/admin-navbar', { activePage: 'inbox' }) %>


    <section class="section" style="padding-top:32px">
      <div class="container">
        <div class="flex justify-between items-center" style="margin-bottom:24px;flex-wrap:wrap;gap:12px">
          <div>
            <h1 style="font-size:28px;font-weight:700;margin-bottom:4px">Support Inbox</h1>
            <p style="color:var(--muted-fg)">Manage and triage customer support requests and queries.</p>
          </div>
          <div style="display:flex; gap:8px;">
            <a href="/admin/contact-messages?status=open"
              class="btn btn-sm <%= activeStatus === 'open' ? 'btn-primary' : 'btn-outline' %>">Open</a>
            <a href="/admin/contact-messages?status=in_progress"
              class="btn btn-sm <%= activeStatus === 'in_progress' ? 'btn-primary' : 'btn-outline' %>">In Progress</a>
            <a href="/admin/contact-messages?status=resolved"
              class="btn btn-sm <%= activeStatus === 'resolved' ? 'btn-primary' : 'btn-outline' %>">Resolved</a>
            <a href="/admin/contact-messages?status=all"
              class="btn btn-sm <%= activeStatus === 'all' ? 'btn-primary' : 'btn-outline' %>">All Messages</a>
          </div>
        </div>

        <div class="card" style="overflow:hidden">
          <table style="width:100%;border-collapse:collapse" id="inboxTable">
            <thead>
              <tr style="border-bottom:2px solid var(--border);background:var(--muted)">
                <th
                  style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">
                  Sender</th>
                <th
                  style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">
                  Topic & Message</th>
                <th
                  style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">
                  Assigned To</th>
                <th
                  style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">
                  Status</th>
                <th
                  style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">
                  Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!messages || messages.length===0) { %>
                <tr>
                  <td colspan="5" style="padding:40px;text-align:center;color:var(--muted-fg)">
                    No messages found in this status category.
                  </td>
                </tr>
                <% } else { %>
                  <% messages.forEach(function(msg) { %>
                    <tr style="border-bottom:1px solid var(--border);transition:background .2s" class="inbox-row">
                      <td style="padding:14px 16px;vertical-align:top;width:220px">
                        <div style="font-weight:600;font-size:14px;color:var(--fg)">
                          <%= msg.name %>
                        </div>
                        <div style="font-size:12px;color:var(--muted-fg);word-break:break-all;">
                          <%= msg.email %>
                        </div>
                        <div style="font-size:11px;color:var(--muted-fg);margin-top:4px">
                          <%= new Date(msg.createdAt).toLocaleString() %>
                        </div>
                      </td>
                      <td style="padding:14px 16px;vertical-align:top;">
                        <div style="font-weight:700;font-size:13px;color:var(--primary);margin-bottom:6px">[<%=
                            msg.topic %>]</div>
                        <div style="font-size:14px;color:var(--fg);white-space:pre-wrap;line-height:1.5;">
                          <%= msg.message %>
                        </div>
                        <% if (msg.resolvedAt) { %>
                          <div style="font-size:12px;color:var(--success);margin-top:8px;font-style:italic">
                            Resolved at: <%= new Date(msg.resolvedAt).toLocaleString() %>
                          </div>
                          <% } %>
                      </td>
                      <td style="padding:14px 16px;vertical-align:top;width:150px">
                        <% if (msg.handledBy) { %>
                          <span class="badge badge-outline" style="font-weight:600">
                            <%= msg.handledBy.username %>
                          </span>
                          <% } else { %>
                            <span style="color:var(--muted-fg);font-size:13px">Unassigned</span>
                            <% } %>
                      </td>
                      <td style="padding:14px 16px;vertical-align:top;width:120px">
                        <% if (msg.status==='open' ) { %>
                          <span class="badge" style="color:var(--primary);border-color:var(--primary)">Open</span>
                          <% } else if (msg.status==='in_progress' ) { %>
                            <span class="badge" style="color:#D97706;border-color:#D97706">In Progress</span>
                            <% } else { %>
                              <span class="badge"
                                style="color:var(--success);border-color:var(--success)">Resolved</span>
                              <% } %>
                      </td>
                      <td style="padding:14px 16px;vertical-align:top;width:150px">
                        <div style="display:flex;flex-direction:column;gap:8px">
                          <% if (msg.status==='open' ) { %>
                            <form method="POST" action="/admin/contact-messages/<%= msg._id %>/claim">
                              <button type="submit" class="btn btn-sm btn-block"
                                style="color:var(--muted-fg);font-size:13px;font-style:italic">Claim Message</button>
                            </form>
                            <% } else if (msg.status==='in_progress' ) { %>
                              <form method="POST" action="/admin/contact-messages/<%= msg._id %>/resolve">
                                <button type="submit" class="btn btn-sm btn-success btn-block"
                                  style="color:var(--muted-fg);font-size:13px;font-style:italic">Mark Resolved</button>
                              </form>
                              <% } else { %>
                                <span style="color:var(--muted-fg);font-size:13px;font-style:italic">Resolved</span>
                                <% } %>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                      <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <script src="/js/app.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        // Row hovering effects
        var rows = document.querySelectorAll('.inbox-row');
        rows.forEach(function (row) {
          row.addEventListener('mouseenter', function () {
            row.style.background = 'var(--hover-surface)';
          });
          row.addEventListener('mouseleave', function () {
            row.style.background = '';
          });
        });
      });
    </script>
</body>

</html>
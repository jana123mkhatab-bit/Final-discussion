<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Admin Audit Logs — Swapify Admin</title>
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
</head>
<body>
<%- include('../partials/admin-navbar', { activePage: 'logs' }) %>


  <section class="section" style="padding-top:32px">
    <div class="container">
      <div style="margin-bottom:24px">
        <h1 style="font-size:28px;font-weight:700;margin-bottom:4px">Admin Audit Trail</h1>
        <p style="color:var(--muted-fg)">A complete, read-only security log of all destructive and administrative actions performed on Swapify.</p>
      </div>

      <!-- Filters Panel -->
      <div class="card card-body" style="margin-bottom:24px; padding: 20px;">
        <form method="GET" action="/admin/logs" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) 100px; gap: 16px; align-items: flex-end;">
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:6px; color:var(--muted-fg); text-transform:uppercase;">Action Type</label>
            <select name="action" class="input" style="width:100%">
              <option value="">-- All Actions --</option>
              <option value="ban_user" <%= filter.action === 'ban_user' ? 'selected' : '' %>>Ban User</option>
              <option value="unban_user" <%= filter.action === 'unban_user' ? 'selected' : '' %>>Unban User</option>
              <option value="delete_item" <%= filter.action === 'delete_item' ? 'selected' : '' %>>Delete Item (Soft)</option>
              <option value="delete_skill" <%= filter.action === 'delete_skill' ? 'selected' : '' %>>Delete Skill (Soft)</option>
              <option value="delete_swap" <%= filter.action === 'delete_swap' ? 'selected' : '' %>>Delete Swap</option>
              <option value="resolve_report" <%= filter.action === 'resolve_report' ? 'selected' : '' %>>Resolve Report</option>
              <option value="dismiss_report" <%= filter.action === 'dismiss_report' ? 'selected' : '' %>>Dismiss Report</option>
              <option value="adjust_points" <%= filter.action === 'adjust_points' ? 'selected' : '' %>>Adjust Points</option>
              <option value="hard_delete" <%= filter.action === 'hard_delete' ? 'selected' : '' %>>Hard Delete (GDPR)</option>
              <option value="assign_contact_message" <%= filter.action === 'assign_contact_message' ? 'selected' : '' %>>Assign Contact Msg</option>
              <option value="resolve_contact_message" <%= filter.action === 'resolve_contact_message' ? 'selected' : '' %>>Resolve Contact Msg</option>
              <option value="approve_skill" <%= filter.action === 'approve_skill' ? 'selected' : '' %>>Approve Skill</option>
              <option value="reject_skill" <%= filter.action === 'reject_skill' ? 'selected' : '' %>>Reject Skill</option>
              <option value="approve_object" <%= filter.action === 'approve_object' ? 'selected' : '' %>>Approve Object</option>
              <option value="reject_object" <%= filter.action === 'reject_object' ? 'selected' : '' %>>Reject Object</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:6px; color:var(--muted-fg); text-transform:uppercase;">Admin User ID</label>
            <input type="text" name="admin" class="input" placeholder="Admin ObjectId..." value="<%= filter.admin || '' %>" style="width:100%">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:6px; color:var(--muted-fg); text-transform:uppercase;">Target Doc ID</label>
            <input type="text" name="targetId" class="input" placeholder="Target ObjectId..." value="<%= filter.targetId || '' %>" style="width:100%">
          </div>
          <div>
            <button type="submit" class="btn btn-primary btn-block" style="padding:12px 0">Filter</button>
          </div>
        </form>
      </div>

      <!-- Logs Table -->
      <div class="card" style="overflow:hidden">
        <table style="width:100%;border-collapse:collapse" id="logsTable">
          <thead>
            <tr style="border-bottom:2px solid var(--border);background:var(--muted)">
              <th style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">Timestamp</th>
              <th style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">Admin</th>
              <th style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">Action</th>
              <th style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">Target Document</th>
              <th style="padding:14px 16px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted-fg)">Details / Metadata</th>
            </tr>
          </thead>
          <tbody>
            <% if (!logs || logs.length === 0) { %>
              <tr>
                <td colspan="5" style="padding:40px;text-align:center;color:var(--muted-fg)">
                  No audit logs found matching the filter criteria.
                </td>
              </tr>
            <% } else { %>
              <% logs.forEach(function(log) { %>
                <tr style="border-bottom:1px solid var(--border);transition:background .2s" class="log-row">
                  <td style="padding:14px 16px;font-size:13px;color:var(--muted-fg);width:180px">
                    <%= new Date(log.createdAt).toLocaleString() %>
                  </td>
                  <td style="padding:14px 16px;width:150px">
                    <div style="font-weight:600;font-size:14px"><%= log.admin ? log.admin.username : 'Unknown Admin' %></div>
                    <div style="font-size:10px;color:var(--muted-fg);word-break:break-all;"><%= log.admin ? log.admin._id : '' %></div>
                  </td>
                  <td style="padding:14px 16px;width:160px">
                    <% 
                      var badgeColor = 'var(--muted-fg)';
                      if (log.action.includes('delete') || log.action.includes('ban') || log.action.includes('reject')) badgeColor = 'var(--error)';
                      if (log.action.includes('resolve') || log.action.includes('unban') || log.action.includes('approve')) badgeColor = 'var(--success)';
                      if (log.action.includes('adjust') || log.action.includes('assign')) badgeColor = 'var(--primary)';
                    %>
                    <span class="badge" style="color:<%= badgeColor %>; border-color:<%= badgeColor %>; font-size:11px; text-transform:uppercase;">
                      <%= log.action.replace(/_/g, ' ') %>
                    </span>
                  </td>
                  <td style="padding:14px 16px;width:240px">
                    <div style="font-weight:600;font-size:13px;color:var(--fg)">Collection: <span style="font-weight:700;color:var(--primary)"><%= log.targetCollection %></span></div>
                    <div style="font-size:11px;color:var(--muted-fg)">ID: <code style="background:var(--hover-surface);padding:2px 4px;border-radius:4px;"><%= log.targetId %></code></div>
                  </td>
                  <td style="padding:14px 16px;font-size:13px;color:var(--fg)">
                    <pre style="margin:0;font-family:monospace;font-size:12px;background:var(--input-bg);padding:8px;border-radius:6px;max-height:100px;overflow-y:auto;white-space:pre-wrap;"><%= JSON.stringify(log.metadata, null, 2) %></pre>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div style="display:flex; justify-content:center; align-items:center; margin-top:24px; gap:8px;">
          <% if (currentPage > 1) { %>
            <a href="/admin/logs?page=<%= currentPage - 1 %>&action=<%= filter.action || '' %>&admin=<%= filter.admin || '' %>&targetId=<%= filter.targetId || '' %>" class="btn btn-outline btn-sm">&larr; Previous</a>
          <% } %>
          <span style="font-size:14px;color:var(--muted-fg)">Page <%= currentPage %> of <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a href="/admin/logs?page=<%= currentPage + 1 %>&action=<%= filter.action || '' %>&admin=<%= filter.admin || '' %>&targetId=<%= filter.targetId || '' %>" class="btn btn-outline btn-sm">Next &rarr;</a>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>

  <script src="/js/app.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var rows = document.querySelectorAll('.log-row');
      rows.forEach(function(row) {
        row.addEventListener('mouseenter', function() {
          row.style.background = 'var(--hover-surface)';
        });
        row.addEventListener('mouseleave', function() {
          row.style.background = '';
        });
      });
    });
  </script>
</body>
</html>

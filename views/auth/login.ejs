          background:linear-gradient(135deg,#6d28d9,#a855f7,#e879f9,#a855f7,#7c3aed);
          background-size:200% auto;
          border:none;border-radius:11px;
          font-family:'Inter',sans-serif;font-weight:700;font-size:.92rem;
          color:#fff;cursor:pointer;transition:all .3s ease;
        " onmouseover="this.style.backgroundPosition='right center';this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 28px rgba(168,85,247,.45)';"
           onmouseout="this.style.backgroundPosition='';this.style.transform='';this.style.boxShadow='';">
          Send Reset Link
        </button>
      </div>

      <!-- State: success -->
      <div id="fpm-success" style="display:none;text-align:center;padding:8px 0;">
        <div style="width:60px;height:60px;border-radius:50%;margin:0 auto 16px;
          background:rgba(107,203,119,.12);border:2px solid rgba(107,203,119,.35);
          display:flex;align-items:center;justify-content:center;
          animation:fpmPop .55s cubic-bezier(.175,.885,.32,1.275) both;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6bcb77" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <p style="font-size:.95rem;font-weight:700;color:#6bcb77;margin-bottom:8px;">Email sent!</p>
        <p style="font-size:.82rem;color:rgba(255,255,255,.5);line-height:1.5;">
          If that email is registered, a reset link has been sent. Check your inbox (and spam folder).
        </p>
        <button onclick="document.getElementById('forgotModal').style.display='none'" style="
          margin-top:18px;padding:10px 24px;
          background:rgba(168,85,247,.12);border:1px solid rgba(168,85,247,.25);
          border-radius:10px;color:#a855f7;font-family:'Inter',sans-serif;
          font-weight:600;font-size:.85rem;cursor:pointer;
        ">Close</button>
      </div>
    </div>
  </div>

  <style>
    @keyframes modalIn { from { opacity:0; transform:scale(.92) translateY(20px); } to { opacity:1; transform:scale(1) translateY(0); } }
    @keyframes fpmPop  { from { transform:scale(0); opacity:0; } to { transform:scale(1); opacity:1; } }
  </style>

  <script>
  (() => {
    const modal      = document.getElementById('forgotModal');
    const closeBtn   = document.getElementById('closeForgotModal');
    const openBtn    = document.getElementById('openForgotModal');
    const sendBtn    = document.getElementById('fpmSend');
    const emailInput = document.getElementById('fpmEmail');
    const errSpan    = document.getElementById('fpmErr');
    const formDiv    = document.getElementById('fpm-form');
    const successDiv = document.getElementById('fpm-success');

    function openModal() {
      modal.style.display = 'flex';
      emailInput.value = '';
      errSpan.textContent = '';
      formDiv.style.display = 'block';
      successDiv.style.display = 'none';
      sendBtn.disabled = false;
      sendBtn.textContent = 'Send Reset Link';
      setTimeout(() => emailInput.focus(), 80);
    }

    function closeModal() { modal.style.display = 'none'; }

    openBtn  && openBtn.addEventListener('click',  openModal);
    closeBtn && closeBtn.addEventListener('click',  closeModal);

    // Close on backdrop click
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

    // Close on Escape
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && modal.style.display === 'flex') closeModal(); });

    // Submit via fetch
    sendBtn && sendBtn.addEventListener('click', async () => {
      const email = emailInput.value.trim();
      errSpan.textContent = '';

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errSpan.textContent = 'Please enter a valid email address.';
        emailInput.style.borderColor = '#ff6b6b';
        return;
      }
      emailInput.style.borderColor = '';

      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending…';

      try {
        const res  = await fetch('/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        if (data.success) {
          formDiv.style.display    = 'none';
          successDiv.style.display = 'block';
        } else {
          errSpan.textContent = data.error || 'Something went wrong. Please try again.';
          sendBtn.disabled = false;
          sendBtn.textContent = 'Send Reset Link';
        }
      } catch (err) {
        errSpan.textContent = 'Network error. Please try again.';
        sendBtn.disabled = false;
        sendBtn.textContent = 'Send Reset Link';
      }
    });

    // Allow pressing Enter in the email field
    emailInput && emailInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); sendBtn.click(); }
    });

    // Show success toast if redirected after password reset
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('action') === 'passwordreset') {
      window.history.replaceState({}, '', '/login');
      // Use SwapifyUI toast if available, otherwise simple alert
      setTimeout(() => {
        if (typeof SwapifyUI !== 'undefined' && SwapifyUI.toast) {
          SwapifyUI.toast('Password reset successfully! Please log in.', 'success');
        } else {
          const tc = document.querySelector('.tcont');
          if (tc) {
            const t = document.createElement('div');
            t.className = 'toast success';
            t.innerHTML = '<span style="font-size:16px">✅</span> Password reset! Please log in.';
            tc.appendChild(t);
            setTimeout(() => t.remove(), 4000);
          }
        }
      }, 300);
    }
  })();
  </script>

</body>
</html>
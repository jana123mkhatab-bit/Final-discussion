<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Set New Password — Swapify</title>
  <meta name="description" content="Set a new password for your Swapify account.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:          #0e1012;
      --neon:        #a855f7;
      --neon-bright: #e879f9;
      --neon-dim:    #7c3aed;
      --glass-bg:    rgba(168,85,247,0.05);
      --glass-brd:   rgba(168,85,247,0.14);
      --glass-hov:   rgba(168,85,247,0.08);
      --text:        #ffffff;
      --muted:       rgba(255,255,255,0.50);
      --in-bg:       rgba(255,255,255,0.06);
      --in-focus:    rgba(168,85,247,0.12);
      --red:         #ff6b6b;
      --green:       #6bcb77;
      --tr-b:        0.65s cubic-bezier(.175,.885,.32,1.275);
    }

    html, body { height: 100%; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      position: relative;
      overflow: hidden;
    }

    .bg-glow {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background:
        radial-gradient(ellipse 55% 50% at 20% 30%, rgba(124,58,237,.14), transparent 65%),
        radial-gradient(ellipse 45% 40% at 80% 70%, rgba(232,121,249,.08), transparent 60%);
    }

    .particles { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .particle {
      position: absolute; border-radius: 50%;
      background: var(--neon-bright); opacity: 0;
      box-shadow: 0 0 6px var(--neon);
      animation: float-up linear infinite;
    }
    @keyframes float-up {
      0%   { transform: translateY(100vh) scale(0); opacity: 0; }
      10%  { opacity: .5; }
      90%  { opacity: .15; }
      100% { transform: translateY(-10vh) scale(1); opacity: 0; }
    }

    .card {
      position: relative; z-index: 5;
      background: var(--glass-bg);
      backdrop-filter: blur(28px); -webkit-backdrop-filter: blur(28px);
      border: 1px solid var(--glass-brd);
      border-radius: 28px;
      width: clamp(320px, 92vw, 420px);
      padding: 36px 32px 32px;
      box-shadow: 0 28px 55px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.04), inset 0 1px 0 rgba(255,255,255,.08);
      overflow: hidden;
      animation: cardIn .55s var(--tr-b) both;
    }
    @keyframes cardIn { from { opacity:0; transform:translateY(30px) scale(.95); } to { opacity:1; transform:translateY(0) scale(1); } }
    .card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--neon-bright), var(--neon), transparent);
    }

    .logo {
      display: flex; align-items: center; justify-content: center; gap: 9px;
      text-decoration: none; margin-bottom: 28px;
    }
    .logo-icon {
      width: 32px; height: 32px; border-radius: 10px;
      background: linear-gradient(135deg, var(--neon-bright), var(--neon));
      display: flex; align-items: center; justify-content: center; color: #fff; flex-shrink: 0;
    }
    .logo-text {
      font-size: 1.2rem; font-weight: 800;
      background: linear-gradient(135deg, var(--neon-bright), var(--neon));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }

    .step-icon {
      width: 56px; height: 56px; border-radius: 16px; margin: 0 auto 18px;
      background: rgba(168,85,247,.12);
      border: 1px solid rgba(168,85,247,.25);
      display: flex; align-items: center; justify-content: center;
      color: var(--neon-bright);
    }
    .step-icon svg { width: 26px; height: 26px; }
    h1 { text-align: center; font-size: 1.3rem; font-weight: 800; margin-bottom: 6px; }
    p.sub { text-align: center; font-size: .82rem; color: var(--muted); margin-bottom: 24px; line-height: 1.5; }

    .fgroup { margin-bottom: 14px; }
    .flabel { display: block; color: var(--muted); font-size: .72rem; font-weight: 600; margin-bottom: 5px; letter-spacing: .5px; text-transform: uppercase; }
    .iwrap { position: relative; }
    .iicon {
      position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
      width: 15px; height: 15px; color: var(--muted); pointer-events: none;
    }
    .eye-toggle {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      width: 32px; height: 32px; border-radius: 8px;
      background: transparent; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      color: var(--muted); transition: color .2s, background .2s; padding: 0;
    }
    .eye-toggle:hover { color: var(--neon-bright); background: rgba(168,85,247,.12); }
    .eye-toggle svg { width: 16px; height: 16px; pointer-events: none; }
    .finput {
      width: 100%; padding: 12px 12px 12px 40px;
      background: var(--in-bg); border: 1px solid transparent; border-radius: 11px;
      color: var(--text); font-family: 'Inter', sans-serif; font-size: .88rem;
      outline: none; transition: all .28s ease;
    }
    .finput.has-toggle { padding-right: 44px; }
    .finput::placeholder { color: rgba(255,255,255,.22); }
    .finput:focus { border-color: var(--neon); background: var(--in-focus); box-shadow: 0 0 0 3px rgba(168,85,247,.15); }
    .finput.valid   { border-color: var(--green); }
    .finput.invalid { border-color: var(--red); }
    .ferr { display: block; font-size: .72rem; color: var(--red); margin-top: 4px; margin-left: 3px; min-height: 15px; }

    .sbars { display: flex; gap: 4px; margin-top: 7px; }
    .sbar  { flex: 1; height: 3px; border-radius: 2px; background: rgba(255,255,255,.1); transition: background .3s; }
    .sbars.weak   .sbar:nth-child(1)                                   { background: var(--red); }
    .sbars.medium .sbar:nth-child(1), .sbars.medium .sbar:nth-child(2) { background: #f59e0b; }
    .sbars.strong .sbar                                                 { background: var(--green); }

    .sbtn {
      width: 100%; padding: 13px; margin-top: 8px;
      background: linear-gradient(135deg, #6d28d9, #a855f7, #e879f9, #a855f7, #7c3aed);
      background-size: 200% auto;
      border: none; border-radius: 11px;
      font-family: 'Inter', sans-serif; font-weight: 700; font-size: .92rem;
      color: #fff; cursor: pointer; transition: all .3s ease; position: relative;
      display: block; text-align: center; text-decoration: none;
    }
    .sbtn:hover { background-position: right center; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(168,85,247,.45); }
    .sbtn:active { transform: translateY(0); }
    .sbtn:disabled { opacity: .6; cursor: not-allowed; transform: none; }

    .alert-err {
      display: flex; gap: 10px; align-items: flex-start;
      padding: 12px 14px; border-radius: 12px; margin-bottom: 20px;
      background: rgba(255,107,107,.08); border: 1px solid rgba(255,107,107,.25);
      font-size: .82rem; color: #ff9898; line-height: 1.5;
    }
    .alert-err svg { flex-shrink: 0; width: 16px; height: 16px; margin-top: 1px; color: var(--red); }

    .back-link {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      margin-top: 18px; font-size: .8rem; color: var(--muted);
      text-decoration: none; transition: color .2s;
    }
    .back-link:hover { color: var(--neon-bright); }
    .back-link svg { width: 14px; height: 14px; }

    .success-wrap { text-align: center; padding: 10px 0 24px; }
    .success-icon {
      width: 70px; height: 70px; border-radius: 50%; margin: 0 auto 20px;
      background: rgba(107,203,119,.12); border: 2px solid rgba(107,203,119,.35);
      display: flex; align-items: center; justify-content: center;
      animation: pop .55s var(--tr-b) both;
    }
    @keyframes pop { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .success-icon svg { width: 32px; height: 32px; color: var(--green); }
  </style>
</head>
<body>

  <div class="bg-glow"></div>
  <div class="particles" id="particles"></div>

  <div class="card">
    <a href="/login" class="logo">
      <div class="logo-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M8 3L4 7l4 4"/><path d="M4 7h16"/>
          <path d="M16 21l4-4-4-4"/><path d="M20 17H4"/>
        </svg>
      </div>
      <span class="logo-text">Swapify</span>
    </a>

    <% if (!valid) { %>
      <!-- ── INVALID / EXPIRED TOKEN ── -->
      <div class="step-icon" style="background:rgba(255,107,107,.1);border-color:rgba(255,107,107,.25);color:#ff9898;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <h1>Link Expired</h1>
      <p class="sub"><%= error || 'This reset link is no longer valid.' %></p>
      <a href="/login" class="sbtn" style="margin-top:4px">Request a New Link</a>
      <a href="/login" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to login
      </a>

    <% } else { %>
      <!-- ── PASSWORD FORM ── -->
      <div class="step-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <h1>Set New Password</h1>
      <p class="sub">Choose a strong password for your account.</p>

      <% if (error) { %>
        <div class="alert-err">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/reset-password/<%= token %>" id="resetForm" novalidate>
        <div class="fgroup">
          <label class="flabel" for="password">New Password</label>
          <div class="iwrap">
            <svg class="iicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <input type="password" class="finput has-toggle" id="password" name="password"
              placeholder="Min 10 chars" autocomplete="new-password" required>
            <button type="button" class="eye-toggle" data-target="password" aria-label="Show password">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eye-open"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eye-shut" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-10-8-10-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 8 10 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <div class="sbars" id="strengthBars">
            <div class="sbar"></div><div class="sbar"></div><div class="sbar"></div><div class="sbar"></div>
          </div>
          <span class="ferr" id="passwordErr"></span>
        </div>

        <div class="fgroup">
          <label class="flabel" for="confirmPassword">Confirm Password</label>
          <div class="iwrap">
            <svg class="iicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <input type="password" class="finput has-toggle" id="confirmPassword" name="confirmPassword"
              placeholder="Repeat password" autocomplete="new-password" required>
            <button type="button" class="eye-toggle" data-target="confirmPassword" aria-label="Show password">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eye-open"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eye-shut" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-10-8-10-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 8 10 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <span class="ferr" id="confirmErr"></span>
        </div>

        <button type="submit" class="sbtn" id="submitBtn">Reset Password</button>
      </form>

      <a href="/login" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to login
      </a>
    <% } %>
  </div>

  <script>
  (() => {
    // Particles
    const pel = document.getElementById('particles');
    if (pel) {
      for (let i = 0; i < 8; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        const size = Math.random() * 4 + 2;
        Object.assign(p.style, {
          width: size + 'px', height: size + 'px',
          left: Math.random() * 100 + '%',
          animationDuration: (Math.random() * 12 + 10) + 's',
          animationDelay: (Math.random() * 10) + 's'
        });
        pel.appendChild(p);
      }
    }

    // Eye toggles
    document.addEventListener('click', e => {
      const btn = e.target.closest('.eye-toggle');
      if (!btn) return;
      const input = document.getElementById(btn.dataset.target);
      if (!input) return;
      const show = input.type === 'text';
      input.type = show ? 'password' : 'text';
      btn.querySelector('.eye-open').style.display = show ? '' : 'none';
      btn.querySelector('.eye-shut').style.display = show ? 'none' : '';
      input.focus();
    });

    // Strength bars
    const pwInput = document.getElementById('password');
    const bars    = document.getElementById('strengthBars');
    if (pwInput && bars) {
      pwInput.addEventListener('input', () => {
        const v = pwInput.value;
        let score = 0;
        if (v.length >= 10)             score++;
        if (/[A-Z]/.test(v))            score++;
        if (/[0-9]/.test(v))            score++;
        if (/[^A-Za-z0-9]/.test(v))     score++;
        bars.className = 'sbars ' + (['', 'weak', 'medium', 'medium', 'strong'][score] || '');
      });
    }

    // Client-side validation before submit
    const form = document.getElementById('resetForm');
    if (form) {
      form.addEventListener('submit', e => {
        const pw   = document.getElementById('password').value;
        const conf = document.getElementById('confirmPassword').value;
        const pwErr   = document.getElementById('passwordErr');
        const confErr = document.getElementById('confirmErr');
        let ok = true;

        if (pw.length < 10) {
          pwErr.textContent = 'Password must be at least 10 characters.';
          document.getElementById('password').classList.add('invalid');
          ok = false;
        } else {
          pwErr.textContent = '';
          document.getElementById('password').classList.remove('invalid');
        }

        if (pw !== conf) {
          confErr.textContent = 'Passwords do not match.';
          document.getElementById('confirmPassword').classList.add('invalid');
          ok = false;
        } else {
          confErr.textContent = '';
          document.getElementById('confirmPassword').classList.remove('invalid');
        }

        if (!ok) e.preventDefault();
        else {
          const btn = document.getElementById('submitBtn');
          if (btn) { btn.disabled = true; btn.textContent = 'Resetting…'; }
        }
      });
    }
  })();
  </script>
</body>
</html>

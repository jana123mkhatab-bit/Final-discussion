  <!-- Shared engine first, then home-specific logic -->
  <script src="https://unpkg.com/lenis@1.1.16/dist/lenis.min.js" defer></script>
  <script src="/js/app.js" defer></script>
  <script src="/js/home.js" defer></script>
  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/htm/dist/htm.js"></script>
  <script src="/js/recommended-stack.js"></script>
  <script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
  <script>
    (function () {
      function createGlobe(elementId, colorBase, colorGlow, colorNodes, showSphere) {
        var mountElement = document.getElementById(elementId);
        if (!mountElement || mountElement.dataset.globeInit || !window.THREE) return;

        var width = mountElement.clientWidth;
        var height = mountElement.clientHeight;
        if (!width || !height) return;

        mountElement.dataset.globeInit = '1';

        var scene = new THREE.Scene();
        var camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 1000);
        camera.position.z = 4;

        var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.setSize(width, height);
        renderer.setClearColor(0x000000, 0);
        mountElement.appendChild(renderer.domElement);

        var globeGroup = new THREE.Group();
        scene.add(globeGroup);

        if (showSphere) {
          var globeGeometry = new THREE.SphereGeometry(1.2, 64, 64);
          var globeMaterial = new THREE.MeshBasicMaterial({
            color: colorBase,
            wireframe: true,
            transparent: true,
            opacity: 0.25
          });
          globeGroup.add(new THREE.Mesh(globeGeometry, globeMaterial));

          var glowMaterial = new THREE.MeshBasicMaterial({
            color: colorGlow,
            transparent: true,
            opacity: 0.08
          });
          globeGroup.add(new THREE.Mesh(new THREE.SphereGeometry(1.18, 64, 64), glowMaterial));

          var nodeCount = 500;
          var positions = [];
          for (var i = 0; i < nodeCount; i++) {
            var theta = Math.random() * Math.PI * 2;
            var phi = Math.acos(Math.random() * 2 - 1);
            var radius = 1.23;
            positions.push(
              radius * Math.sin(phi) * Math.cos(theta),
              radius * Math.sin(phi) * Math.sin(theta),
              radius * Math.cos(phi)
            );
          }

          var nodeGeometry = new THREE.BufferGeometry();
          nodeGeometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
          var nodeMaterial = new THREE.PointsMaterial({
            color: colorNodes,
            size: 0.02,
            transparent: true,
            opacity: 0.9
          });
          globeGroup.add(new THREE.Points(nodeGeometry, nodeMaterial));

          var lineMaterial = new THREE.LineBasicMaterial({
            color: 0xffffff,
            transparent: true,
            opacity: 0.25
          });
          for (var j = 0; j < 250; j++) {
            var p1 = Math.floor(Math.random() * nodeCount) * 3;
            var p2 = Math.floor(Math.random() * nodeCount) * 3;
            var linePoints = [
              new THREE.Vector3(positions[p1], positions[p1 + 1], positions[p1 + 2]),
              new THREE.Vector3(positions[p2], positions[p2 + 1], positions[p2 + 2])
            ];
            var lineGeometry = new THREE.BufferGeometry().setFromPoints(linePoints);
            globeGroup.add(new THREE.Line(lineGeometry, lineMaterial));
          }
        }

        var outerGeometry = new THREE.BufferGeometry();
        var outerPositions = [];
        var starCount = showSphere ? 200 : 700;
        for (var k = 0; k < starCount; k++) {
          outerPositions.push(
            (Math.random() - 0.5) * 10,
            (Math.random() - 0.5) * 10,
            (Math.random() - 0.5) * 10
          );
        }
        outerGeometry.setAttribute('position', new THREE.Float32BufferAttribute(outerPositions, 3));
        var outerMaterial = new THREE.PointsMaterial({
          color: 0xffffff,
          size: 0.015,
          transparent: true,
          opacity: 0.7
        });
        var outerParticles = new THREE.Points(outerGeometry, outerMaterial);
        scene.add(outerParticles);

        var mouseX = 0;
        var mouseY = 0;
        var isHovered = false;
        function handleMouseMove(event) {
          isHovered = true;
          var rect = mountElement.getBoundingClientRect();
          var x = (event.clientX - rect.left) / rect.width - 0.5;
          var y = (event.clientY - rect.top) / rect.height - 0.5;
          mouseX = x * 2;
          mouseY = y * 2;
        }
        function handleMouseLeave() {
          isHovered = false;
        }
        mountElement.addEventListener('mousemove', handleMouseMove);
        mountElement.addEventListener('mouseleave', handleMouseLeave);

        function updateSize() {
          var rect = mountElement.getBoundingClientRect();
          var w = rect.width;
          var h = rect.height;
          if (!w || !h) return;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        }

        var resizeObserver = null;
        if (window.ResizeObserver) {
          resizeObserver = new ResizeObserver(updateSize);
          resizeObserver.observe(mountElement);
        } else {
          window.addEventListener('resize', updateSize);
        }

        var currentRotationY = 0;
        var currentRotationX = 0;
        var animationFrameId = 0;
        function animate() {
          animationFrameId = requestAnimationFrame(animate);
          if (isHovered) {
            var targetY = mouseX * 0.8;
            var targetX = mouseY * 0.5;
            currentRotationY += (targetY - currentRotationY) * 0.08;
            currentRotationX += (targetX - currentRotationX) * 0.08;
          } else {
            currentRotationY += 0.005;
            currentRotationX += (0 - currentRotationX) * 0.08;
          }
          globeGroup.rotation.y = currentRotationY;
          globeGroup.rotation.x = currentRotationX;
          outerParticles.rotation.y += showSphere ? 0.0005 : 0.0015;
          renderer.render(scene, camera);
        }

        animate();
      }

      function createCosmicGalaxy(containerId, sectionId, interactive) {
        var container = document.getElementById(containerId);
        var targetSection = document.getElementById(sectionId);
        if (!container || !targetSection) return;

        var scene, camera, renderer;
        var galaxyGeometry, galaxyPoints, galaxyMaterial;
        var nebulaGas, nebulaMaterial;

        var config = {
          starsCount: 40000,       // Cleaner, less crowded star count
          size: 0.22,              // Smaller, less intense sparkles
          radius: interactive ? 110 : 160, // Spheroid radius (wider for non-interactive)
          flatteningY: 0.35,       // Flatness factor to squash on Y axis
          insideColor: '#ffffff',
          outsideColor: '#d8b4fe',
          secondaryColor: '#22d3ee',
          // Custom drift speeds for X, Y, Z for non-interactive
          rotSpeedX: interactive ? 0 : 0.0001 + Math.random() * 0.00015,
          rotSpeedY: interactive ? 0.0006 : 0.0002 + Math.random() * 0.0002,
          rotSpeedZ: interactive ? 0 : (Math.random() - 0.5) * 0.0001,
          turbulenceActive: true
        };

        var targetXRot = 0.45;
        var targetYRot = 0;
        var currentXRot = 0.45;
        var currentYRot = 0;

        var isDragging = false;
        var previousMousePosition = { x: 0, y: 0 };
        var dragRotation = { x: 0, y: 0 };

        var mouse = { x: 0, y: 0 };
        var isMouseOverSection = false;

        function createGlowTexture(colorStr, secondaryColorStr) {
          var canvas = document.createElement('canvas');
          canvas.width = 128;
          canvas.height = 128;
          var ctx = canvas.getContext('2d');

          var gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
          gradient.addColorStop(0, '#ffffff');
          gradient.addColorStop(0.12, '#ffffff');
          gradient.addColorStop(0.28, colorStr);
          if (secondaryColorStr) {
            gradient.addColorStop(0.55, secondaryColorStr);
          }
          gradient.addColorStop(1, 'rgba(0,0,0,0)');

          ctx.fillStyle = gradient;
          ctx.beginPath();
          ctx.arc(64, 64, 64, 0, Math.PI * 2);
          ctx.fill();

          return new THREE.CanvasTexture(canvas);
        }

        function initGalaxy() {
          var width = container.clientWidth;
          var height = container.clientHeight;
          if (!width || !height) return;

          scene = new THREE.Scene();

          camera = new THREE.PerspectiveCamera(52, width / height, 0.1, 1000);
          camera.position.set(0, 42, 95);
          camera.lookAt(0, -5, 0);

          renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
          renderer.setSize(width, height);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          renderer.setClearColor(0x000000, 0);

          container.innerHTML = '';
          container.appendChild(renderer.domElement);

          generateCosmos();

          if (interactive) {
            targetSection.addEventListener('mousemove', handleMouseMove);
            targetSection.addEventListener('mouseleave', handleMouseLeave);
            targetSection.addEventListener('mouseenter', handleMouseEnter);
            targetSection.addEventListener('mousedown', handleMouseDown);

            targetSection.addEventListener('touchstart', handleTouchStart, { passive: true });
            targetSection.addEventListener('touchmove', handleTouchMove, { passive: true });
            targetSection.addEventListener('touchend', handleTouchEnd);

            window.addEventListener('mousemove', handleGlobalMouseMove);
            window.addEventListener('mouseup', handleGlobalMouseUp);
          }

          if (window.ResizeObserver) {
            var ro = new ResizeObserver(function () { handleResize(); });
            ro.observe(container);
          } else {
            window.addEventListener('resize', handleResize);
          }
        }

        function generateCosmos() {
          galaxyGeometry = new THREE.BufferGeometry();

          var positions = new Float32Array(config.starsCount * 3);
          var colors = new Float32Array(config.starsCount * 3);
          var randomOffsets = new Float32Array(config.starsCount * 3);

          var colorCore = new THREE.Color(config.insideColor);
          var colorOut = new THREE.Color(config.outsideColor);
          var colorAlt = new THREE.Color(config.secondaryColor);

          for (var i = 0; i < config.starsCount; i++) {
            var i3 = i * 3;

            // Distribute stars uniformly in a squashed sphere (oblate spheroid)
            var theta = Math.random() * Math.PI * 2;
            var phi = Math.acos(Math.random() * 2 - 1);
            var r = Math.pow(Math.random(), 0.6) * config.radius;

            var x = r * Math.sin(phi) * Math.cos(theta);
            var y = r * Math.sin(phi) * Math.sin(theta) * config.flatteningY;
            var z = r * Math.cos(phi);

            positions[i3 + 0] = x;
            positions[i3 + 1] = y;
            positions[i3 + 2] = z;

            var blendedColor = colorCore.clone();
            var rand = Math.random();
            if (rand < 0.45) {
              blendedColor.lerp(colorOut, Math.random());
            } else if (rand < 0.85) {
              blendedColor.lerp(colorAlt, Math.random());
            }

            colors[i3 + 0] = blendedColor.r;
            colors[i3 + 1] = blendedColor.g;
            colors[i3 + 2] = blendedColor.b;

            randomOffsets[i3 + 0] = x;
            randomOffsets[i3 + 1] = y;
            randomOffsets[i3 + 2] = z;
          }

          galaxyGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
          galaxyGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
          galaxyGeometry.setAttribute('randomOffsets', new THREE.BufferAttribute(randomOffsets, 3));

          galaxyMaterial = new THREE.PointsMaterial({
            size: config.size,
            sizeAttenuation: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            vertexColors: true,
            map: createGlowTexture(config.outsideColor, config.secondaryColor),
            transparent: true,
            opacity: 0.8
          });

          galaxyPoints = new THREE.Points(galaxyGeometry, galaxyMaterial);
          scene.add(galaxyPoints);

          var gasCount = Math.floor(config.starsCount * 0.15);
          var gasGeometry = new THREE.BufferGeometry();
          var gasPos = new Float32Array(gasCount * 3);
          var gasColors = new Float32Array(gasCount * 3);

          for (var j = 0; j < gasCount; j++) {
            var j3 = j * 3;
            var theta = Math.random() * Math.PI * 2;
            var phi = Math.acos(Math.random() * 2 - 1);
            var r = Math.pow(Math.random(), 0.8) * config.radius * 0.8;

            var gx = r * Math.sin(phi) * Math.cos(theta);
            var gy = r * Math.sin(phi) * Math.sin(theta) * config.flatteningY;
            var gz = r * Math.cos(phi);

            gasPos[j3 + 0] = gx;
            gasPos[j3 + 1] = gy;
            gasPos[j3 + 2] = gz;

            if (j % 2 === 0) {
              gasColors[j3 + 0] = 0.1;
              gasColors[j3 + 1] = 0.35;
              gasColors[j3 + 2] = 0.75;
            } else {
              gasColors[j3 + 0] = 0.35;
              gasColors[j3 + 1] = 0.1;
              gasColors[j3 + 2] = 0.65;
            }
          }

          gasGeometry.setAttribute('position', new THREE.BufferAttribute(gasPos, 3));
          gasGeometry.setAttribute('color', new THREE.BufferAttribute(gasColors, 3));

          nebulaMaterial = new THREE.PointsMaterial({
            size: config.size * 6.0,
            sizeAttenuation: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            vertexColors: true,
            map: createGlowTexture('#06b6d4', '#9333ea'),
            transparent: true,
            opacity: 0.22
          });

          nebulaGas = new THREE.Points(gasGeometry, nebulaMaterial);
          scene.add(nebulaGas);
        }

        function handleMouseDown(e) {
          isDragging = true;
          previousMousePosition = {
            x: e.clientX,
            y: e.clientY
          };
        }

        function handleMouseMove(e) {
          var rect = targetSection.getBoundingClientRect();
          var x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
          var y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

          mouse.x = x;
          mouse.y = y;

          targetYRot = x * 0.4;
          targetXRot = 0.45 + (y * 0.3);
        }

        function handleTouchStart(e) {
          if (e.touches.length === 1) {
            isDragging = true;
            previousMousePosition = {
              x: e.touches[0].clientX,
              y: e.touches[0].clientY
            };
          }
        }

        function handleTouchMove(e) {
          if (e.touches.length === 1) {
            var rect = targetSection.getBoundingClientRect();
            var x = ((e.touches[0].clientX - rect.left) / rect.width) * 2 - 1;
            var y = -((e.touches[0].clientY - rect.top) / rect.height) * 2 + 1;

            mouse.x = x;
            mouse.y = y;

            targetYRot = x * 0.4;
            targetXRot = 0.45 + (y * 0.3);

            if (isDragging) {
              var deltaMove = {
                x: e.touches[0].clientX - previousMousePosition.x,
                y: e.touches[0].clientY - previousMousePosition.y
              };
              dragRotation.y += deltaMove.x * 0.008;
              dragRotation.x += deltaMove.y * 0.008;

              previousMousePosition = {
                x: e.touches[0].clientX,
                y: e.touches[0].clientY
              };
            }
          }
        }

        function handleTouchEnd() {
          isDragging = false;
          handleMouseLeave();
        }

        function handleMouseEnter() {
          isMouseOverSection = true;
        }

        function handleMouseLeave() {
          isMouseOverSection = false;
          targetYRot = 0;
          targetXRot = 0.45;
          mouse.x = 0;
          mouse.y = 0;
        }

        function handleResize() {
          if (!container || !renderer || !camera) return;
          var w = container.clientWidth;
          var h = container.clientHeight;
          if (!w || !h) return;

          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        }

        function handleGlobalMouseMove(e) {
          if (!isDragging) return;

          var deltaMove = {
            x: e.clientX - previousMousePosition.x,
            y: e.clientY - previousMousePosition.y
          };

          dragRotation.y += deltaMove.x * 0.005;
          dragRotation.x += deltaMove.y * 0.005;

          previousMousePosition = {
            x: e.clientX,
            y: e.clientY
          };
        }

        function handleGlobalMouseUp() {
          isDragging = false;
        }

        var isVisible = false;
        if (window.IntersectionObserver) {
          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              isVisible = entry.isIntersecting;
            });
          }, { threshold: 0.01 });
          observer.observe(container);
        } else {
          isVisible = true;
        }

        function animateCosmos() {
          requestAnimationFrame(animateCosmos);

          if (!isVisible) return;

          if (interactive) {
            currentXRot += (targetXRot - currentXRot) * 0.04;
            currentYRot += (targetYRot - currentYRot) * 0.04;

            if (galaxyPoints) {
              galaxyPoints.rotation.y += 0.0006 + (dragRotation.y * 0.05);
              galaxyPoints.rotation.x = (currentXRot - 0.45) + (dragRotation.x * 0.05);
              galaxyPoints.rotation.z = currentYRot * 0.6;
            }

            if (nebulaGas) {
              nebulaGas.rotation.y += (0.0006 * 0.72) + (dragRotation.y * 0.05);
              nebulaGas.rotation.x = (currentXRot - 0.45) + (dragRotation.x * 0.05);
              nebulaGas.rotation.z = currentYRot * 0.6;
            }

            dragRotation.x *= 0.95;
            dragRotation.y *= 0.95;
          } else {
            if (galaxyPoints) {
              galaxyPoints.rotation.x += config.rotSpeedX;
              galaxyPoints.rotation.y += config.rotSpeedY;
              galaxyPoints.rotation.z += config.rotSpeedZ;
            }
            if (nebulaGas) {
              nebulaGas.rotation.x += config.rotSpeedX * 0.8;
              nebulaGas.rotation.y += config.rotSpeedY * 0.8;
              nebulaGas.rotation.z += config.rotSpeedZ * 0.8;
            }
          }

          if (config.turbulenceActive && galaxyGeometry) {
            var positions = galaxyGeometry.attributes.position.array;
            var offsets = galaxyGeometry.attributes.randomOffsets.array;
            var len = positions.length / 3;
            var time = Date.now() * 0.0022;

            for (var i = 0; i < len; i++) {
              var i3 = i * 3;
              var waveFactor = positions[i3] * 0.05;
              var ripple = Math.sin(time - waveFactor) * 0.15;

              var amplification = interactive && isMouseOverSection ? (1.8 + Math.abs(mouse.y) * 2.5) : 0.8;
              positions[i3 + 1] = offsets[i3 + 1] + (ripple * amplification);
            }
            galaxyGeometry.attributes.position.needsUpdate = true;
          }

          renderer.render(scene, camera);
        }

        initGalaxy();
        animateCosmos();
      }

      function initGlobes() {
        createGlobe('networkGlobe', 0xaa44ff, 0xbb66ff, 0x44ddff, true);
        createCosmicGalaxy('recommendedGlobe', 'recommendedSection', false);
        createCosmicGalaxy('heroCosmicGalaxy', 'heroSection', false);
        createCosmicGalaxy('footerCosmicGalaxy', 'footerSection', false);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGlobes);
      } else {
        initGlobes();
      }
    })();
  </script>
</body>


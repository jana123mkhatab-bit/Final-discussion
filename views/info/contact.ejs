<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Contact Support — Swapify</title>
  <meta name="description" content="Get in touch with Swapify support. We're here to help with any issue.">
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
</head>
<body>
  <%- include('../partials/navbar') %>
  <main>
    <section style="padding:80px 0 40px;background:var(--gradient-hero);color:#fff;text-align:center">
      <div class="container"><div style="font-size:56px;margin-bottom:16px">📨</div>
      <h1 style="font-size:clamp(32px,5vw,56px);font-weight:800;margin-bottom:16px;font-family:var(--font-heading)">Contact Support</h1>
      <p style="font-size:18px;opacity:.85;max-width:540px;margin:0 auto">We typically respond within 24 hours. We're always happy to help.</p></div>
    </section>
    <section class="section"><div class="container" style="max-width:720px">
      <div class="grid grid-3 gap-6" style="margin-bottom:40px;text-align:center">
        <div class="card card-body"><div style="font-size:32px;margin-bottom:8px">💬</div><h3 style="font-weight:700;margin-bottom:4px;font-size:16px">Live Chat</h3><p style="color:var(--muted-fg);font-size:13px">Available Mon–Fri, 9am–6pm GMT</p></div>
        <div class="card card-body"><div style="font-size:32px;margin-bottom:8px">📧</div><h3 style="font-weight:700;margin-bottom:4px;font-size:16px">Email</h3><p style="color:var(--muted-fg);font-size:13px">support@swapify.app</p></div>
        <div class="card card-body"><div style="font-size:32px;margin-bottom:8px">🐦</div><h3 style="font-weight:700;margin-bottom:4px;font-size:16px">Twitter / X</h3><p style="color:var(--muted-fg);font-size:13px">@SwapifyApp</p></div>
      </div>
      <div class="card" style="padding:32px">
        <h2 style="font-weight:700;font-size:22px;margin-bottom:24px">Send us a Message</h2>
        <% if (typeof error !== 'undefined' && error) { %>
          <div style="background:var(--error);color:#fff;padding:12px 16px;border-radius:var(--radius);margin-bottom:16px;font-size:14px"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div style="background:var(--success);color:#fff;padding:12px 16px;border-radius:var(--radius);margin-bottom:16px;font-size:14px"><%= success %></div>
        <% } %>
        <form id="contactForm" action="/contact" method="post" style="display:flex;flex-direction:column;gap:20px">
          <div class="form-group"><label for="contactName">Your Name</label><input class="input" id="contactName" name="name" type="text" placeholder="Sarah Jenkins" required></div>
          <div class="form-group"><label for="contactEmail">Email Address</label><input class="input" id="contactEmail" name="email" type="email" placeholder="you@example.com" required></div>
          <div class="form-group">
            <label for="contactTopic">Topic</label>
            <select class="input" id="contactTopic" name="topic" style="appearance:none">
              <option>General Question</option><option>Swap Issue</option><option>Account Problem</option><option>Report a User</option><option>Partnership Inquiry</option><option>Other</option>
            </select>
          </div>
          <div class="form-group"><label for="contactMsg">Message</label><textarea class="input textarea" id="contactMsg" name="message" placeholder="Describe your issue or question in detail..." required style="min-height:140px;resize:vertical"></textarea></div>
          <button type="submit" class="btn btn-primary btn-lg w-full" id="contactSubmitBtn">Send Message <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></button>
        </form>
      </div>
    </div></section>
  </main>
    <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo" style="margin-bottom:8px" aria-label="Swapify Home">
            <div class="logo-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg></div>
            <span class="logo-text"><span>Swapify</span></span>
          </a>
          <p>The cozy community marketplace where you can swap skills, trade items, and grab amazing half-price deals.</p>
          <div class="footer-social">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Facebook" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on X" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18"/><path d="M6 6L18 18"/></svg>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Instagram" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on LinkedIn" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>
        <div class="footer-col">
          <h4>About Swapify</h4>
          <ul>
            <li><a href="/about">About Swapify</a></li>
            <li><a href="/our-story">Our Story</a></li>
            <li><a href="/how-it-works">How it Works</a></li>
            <li><a href="/sustainability">Sustainability</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Community</h4>
          <ul>
            <li><a href="/guidelines">Guidelines</a></li>
            <li><a href="/success-stories">Success Stories</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Help Center</h4>
          <ul>
            <li><a href="/help-center">Help Center</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact Support</a></li>
            <li><a href="/trust-safety">Trust &amp; Safety</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Swapify. All rights reserved.</p>
        <div class="footer-tagline">
          <span>Less waste. More sharing.</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--primary)" stroke="var(--primary)" stroke-width="2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </div>
      </div>
    </div>
  </footer>
  <script src="/js/app.js" defer></script>
</body></html>

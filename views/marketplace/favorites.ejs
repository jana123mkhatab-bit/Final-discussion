  <nav class="bottom-nav"><a href="/"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Home</span></a><a href="/skills"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg><span>Skills</span></a><a href="/add" class="add-btn"><div class="add-btn-circle"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg></div></a><a href="/messages"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg><span>Messages</span></a><a href="/profile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg><span>Profile</span></a></nav>

  <script src="/js/app.js"></script>
  <script>
  /* Server-injected favourites (MongoDB documents, owner populated) */
  var _serverFavorites = <%- JSON.stringify(
    (favorites || []).map(function(item) {
      return {
        id:        String(item._id),
        title:     item.title,
        category:  item.category,
        condition: item.condition || '',
        location:  item.itemLocation || '',
        image:     (item.images && item.images[0]) ? item.images[0] : '',
        ownerId:   item.creator ? String(item.creator._id) : '',
        ownerName: item.creator ? item.creator.username : 'Swapify User'
      };
    })
  ) %>;

  document.addEventListener('DOMContentLoaded', function () {
    var grid  = document.getElementById('favoritesGrid');
    var empty = document.getElementById('favoritesEmpty');

    if (_serverFavorites.length === 0) {
      empty.style.display = 'block';
      grid.style.display  = 'none';
      return;
    }

    empty.style.display = 'none';
    grid.style.display  = '';

    _serverFavorites.forEach(function (item) {
      var imgSrc  = item.image || '/img/stock_pfp.jpg';
      var itemUrl = item.category === 'skill' ? '/skill-details?id=' + item.id : '/item-details/' + item.id;

      var card = document.createElement('div');
      card.className    = 'item-card fade-in visible';
      card.dataset.itemId = item.id;

      card.innerHTML =
        '<div class="item-card-img">' +
          '<img class="card-img" src="' + imgSrc + '" alt="' + item.title + '" loading="lazy" ' +
               'onerror="this.src=\'/img/stock_pfp.jpg\'">' +
          '<div class="item-card-badges"><span class="badge badge-primary">' + item.category + '</span></div>' +
          '<button class="item-card-fav active" aria-label="Remove from favorites" data-item-id="' + item.id + '">' +
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="#FF4D4D" stroke="#FF4D4D" stroke-width="2">' +
              '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>' +
            '</svg>' +
          '</button>' +
        '</div>' +
        '<div class="item-card-body">' +
          '<a href="' + itemUrl + '"><h3 class="item-card-title">' + item.title + '</h3></a>' +
          '<div class="item-card-meta">' +
            (item.condition ? '<span>' + item.condition + '</span>' : '') +
            (item.condition && item.location ? '<span>•</span>' : '') +
            (item.location  ? '<span>' + item.location  + '</span>' : '') +
          '</div>' +
          '<div class="item-card-footer">' +
            '<div class="item-card-owner">' +
              (item.ownerId
                ? '<a href="/users/' + item.ownerId + '" style="color:inherit;text-decoration:none;font-weight:600" title="View ' + escapeHtml(item.ownerName) + '\'s profile">' + escapeHtml(item.ownerName) + '</a>'
                : '<span>' + escapeHtml(item.ownerName) + '</span>'
              ) +
            '</div>' +
          '</div>' +
        '</div>';

      // Remove-from-favourites via real API
      card.querySelector('.item-card-fav').addEventListener('click', function () {
        var btn = this;
        fetch('/api/favorites/toggle', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ itemId: item.id })
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.success && !data.added) {
              var cardEl = btn.closest('.item-card');
              if (cardEl) cardEl.remove();
              if (!document.querySelector('.item-card')) {
                empty.style.display = 'block';
              }
            }
          })
          .catch(function () {
            if (window.SwapifyUI) SwapifyUI.toast('Could not remove favourite. Try again.', 'error');
          });
      });

      grid.appendChild(card);
    });
  });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Item Details — Swapify</title>
  <meta name="description" content="View item details on Swapify.">
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="section" style="padding-top:32px">
    <div class="container" style="max-width:960px">
      <a href="javascript:history.back()" class="btn btn-ghost btn-sm" style="margin-bottom:24px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> Back</a>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px" id="detailContent">
        <!-- Left: Image -->
        <div>
          <div style="border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--border)">
            <img id="detailImage" src="" alt="" style="width:100%;height:400px;object-fit:cover">
          </div>
        </div>
        <!-- Right: Info -->
        <div>
          <div class="flex items-center gap-2" style="margin-bottom:12px">
            <span class="badge badge-primary" id="detailBadge"></span>
            <span class="badge badge-outline" id="detailCondition"></span>
          </div>
          <h1 style="font-size:32px;font-weight:700;margin-bottom:8px" id="detailTitle"></h1>
          <div class="flex items-center gap-2" style="margin-bottom:16px;color:var(--muted-fg)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span id="detailDistance"></span>
            <span>•</span>
            <span id="detailCategory"></span>
          </div>
          <div id="detailPriceArea" style="display:none;margin-bottom:20px">
            <span style="font-size:28px;font-weight:700;color:var(--success)" id="detailPrice"></span>
            <span style="font-size:16px;color:var(--muted-fg);text-decoration:line-through;margin-left:8px" id="detailOrigPrice"></span>
          </div>
          <p style="color:var(--muted-fg);line-height:1.8;margin-bottom:24px" id="detailDesc"></p>

          <!-- Owner -->
          <div style="display:flex;align-items:center;gap:16px;padding:20px;background:var(--muted);border-radius:var(--radius-md);margin-bottom:24px">
            <img id="ownerAvatar" src="" alt="" style="width:48px;height:48px;border-radius:50%;object-fit:cover;border:2px solid var(--primary)">
            <div style="flex:1">
              <a id="ownerNameLink" href="#" style="text-decoration:none;color:inherit" title="View profile">
                <h4 style="font-weight:600" id="ownerName"></h4>
              </a>
              <div class="item-card-rating" style="font-size:13px"><svg viewBox="0 0 24 24" width="14" height="14"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> <span id="detailRating"></span></div>
            </div>
            <a href="/messages<%= item.creator ? ('?partner=' + item.creator._id) : '' %>" class="btn btn-outline btn-sm">Message</a>
          </div>

          <div class="card" style="padding:16px;margin-bottom:16px" id="ratingBox" data-rating-box
            data-target-id="<%= item._id %>"
            data-target-model="Item"
            data-owner-id="<%= item.creator ? item.creator._id : '' %>"
            data-current-user-id="<%= currentUser ? currentUser._id : '' %>"
            data-is-logged-in="<%= currentUser ? 'true' : 'false' %>">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
              <div>
                <div style="font-weight:600">Rate this listing</div>
                <div style="color:var(--muted-fg);font-size:13px">Average <span data-rating-avg>0.0</span> • <span data-rating-count>0</span> ratings</div>
              </div>
              <div class="rating-stars" style="display:flex;gap:6px">
                <button type="button" class="rating-star" data-score="1" aria-label="Rate 1 star"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
                <button type="button" class="rating-star" data-score="2" aria-label="Rate 2 stars"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
                <button type="button" class="rating-star" data-score="3" aria-label="Rate 3 stars"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
                <button type="button" class="rating-star" data-score="4" aria-label="Rate 4 stars"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
                <button type="button" class="rating-star" data-score="5" aria-label="Rate 5 stars"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
              </div>
            </div>
            <textarea class="input" data-rating-comment rows="3" style="margin-top:12px" placeholder="Optional comment"></textarea>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:12px;gap:12px;flex-wrap:wrap">
              <button class="btn btn-outline btn-sm" data-rating-submit>Submit rating</button>
              <span class="rating-message" data-rating-msg style="font-size:12px;color:var(--muted-fg)"></span>
            </div>
          </div>
          <button class="btn btn-ghost btn-sm" id="reportSellerBtn" style="margin-top:12px;color:var(--muted-fg);width:100%" aria-label="Report this seller"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg> Report this seller</button>

          <!-- Actions -->
          <div>
            <button class="btn btn-primary btn-lg w-full" id="detailSwapBtn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg>
              Request Swap
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

    <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo" style="margin-bottom:8px" aria-label="Swapify Home">
            <div class="logo-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg></div>
            <span class="logo-text"><span>Swapify</span></span>
          </a>
          <p>The cozy community marketplace where you can swap skills, trade items, and grab amazing half-price deals.</p>
          <div class="footer-social">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Facebook" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on X" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18"/><path d="M6 6L18 18"/></svg>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Instagram" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on LinkedIn" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>
        <div class="footer-col">
          <h4>About Swapify</h4>
          <ul>
            <li><a href="/about">About Swapify</a></li>
            <li><a href="/our-story">Our Story</a></li>
            <li><a href="/how-it-works">How it Works</a></li>
            <li><a href="/sustainability">Sustainability</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Community</h4>
          <ul>
            <li><a href="/guidelines">Guidelines</a></li>
            <li><a href="/success-stories">Success Stories</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Help Center</h4>
          <ul>
            <li><a href="/help-center">Help Center</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact Support</a></li>
            <li><a href="/trust-safety">Trust &amp; Safety</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Swapify. All rights reserved.</p>
        <div class="footer-tagline">
          <span>Less waste. More sharing.</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--primary)" stroke="var(--primary)" stroke-width="2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </div>
      </div>
    </div>
  </footer>

  <nav class="bottom-nav"><a href="/"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Home</span></a><a href="/skills"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg><span>Skills</span></a><a href="/add" class="add-btn"><div class="add-btn-circle"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg></div></a><a href="/messages"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg><span>Messages</span></a><a href="/profile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg><span>Profile</span></a></nav>

  <script src="/js/app.js"></script>
  <script src="/js/ratings.js"></script>
  <script src="/js/report-user.js"></script>
  <script>
    // ── EJS data passed to JS ──
    var ITEM_ID      = '<%= item._id %>';
    var IS_OWNER     = '<%= currentUser && item.creator && item.creator._id && item.creator._id.toString() === currentUser._id.toString() %>' === 'true';
    var IS_LOGGED_IN = '<%= currentUser ? "true" : "false" %>' === 'true';
    var ITEM_AVAILABLE = '<%= item.isAvailable %>' === 'true';
    var CREATOR_ID = '<%= item.creator ? item.creator._id : "" %>';

    document.addEventListener('DOMContentLoaded', function () {
      // ── Populate fields from DB item ──────────────────────────────
      var item = {
        title:       '<%= item.title %>',
        description: '<%= item.description %>',
        category:    '<%= item.category %>',
        owner:       '<%= item.creator ? item.creator.username : "Unknown" %>',
        points:      '<%= item.pointsValue %>',
        price:       '<%= item.price || 0 %>',
        originalPrice: '<%= item.originalPrice || 0 %>',
        cachedRating: '<%= item.cachedRating || 0 %>',
        cachedRatingCount: '<%= item.cachedRatingCount || 0 %>'
      };

      document.getElementById('detailTitle').textContent    = item.title;
      document.getElementById('detailDesc').textContent     = item.description;
      document.getElementById('detailBadge').textContent    = item.category;
      document.getElementById('detailCategory').textContent = item.category;
      document.getElementById('detailDistance').textContent = item.points + ' pts';
      document.getElementById('ownerName').textContent      = item.owner;
      if (CREATOR_ID) {
        var ownerNameLink = document.getElementById('ownerNameLink');
        if (ownerNameLink) {
          ownerNameLink.href = '/users/' + CREATOR_ID;
          ownerNameLink.title = 'View ' + item.owner + "'s profile";
        }
      }
      var detailImageSrc = <%- JSON.stringify((item.images && item.images.length) ? item.images[0] : '') %>;
      document.getElementById('detailImage').src = detailImageSrc || '/img/placeholder.jpg';
      var ownerAvatarEl = document.getElementById('ownerAvatar');
      var creatorImg = <%- JSON.stringify((item.creator && item.creator.profileImage) ? item.creator.profileImage : '') %>;
      if (creatorImg) {
        ownerAvatarEl.src = creatorImg;
        ownerAvatarEl.style.display = '';
        if (CREATOR_ID) {
          ownerAvatarEl.style.cursor = 'pointer';
          ownerAvatarEl.title = 'View ' + item.owner + "'s profile";
          ownerAvatarEl.addEventListener('click', function() { window.location.href = '/users/' + CREATOR_ID; });
        }
      } else {
        // No profile image — swap the <img> for an initial-badge
        var creatorInitial = '<%= item.creator ? item.creator.username.charAt(0).toUpperCase() : "?" %>';
        var badge = document.createElement('div');
        badge.textContent = creatorInitial;
        badge.style.cssText = 'width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px;background:var(--primary);color:#fff;border:2px solid var(--primary);flex-shrink:0';
        if (CREATOR_ID) {
          badge.style.cursor = 'pointer';
          badge.title = 'View ' + item.owner + "'s profile";
          badge.addEventListener('click', function() { window.location.href = '/users/' + CREATOR_ID; });
        }
        ownerAvatarEl.replaceWith(badge);
      }
      document.title = item.title + ' — Swapify';
      var ratingValue = parseFloat(item.cachedRating) || 0;
      var ratingCount = parseInt(item.cachedRatingCount, 10) || 0;
      document.getElementById('detailRating').textContent = ratingCount ? ratingValue.toFixed(1) + ' (' + ratingCount + ')' : ratingValue.toFixed(1);

      if (item.category === 'deal') {
        document.getElementById('detailPriceArea').style.display = 'block';
        document.getElementById('detailPrice').textContent = '$' + item.price;
        document.getElementById('detailOrigPrice').textContent = '$' + item.originalPrice;
        document.getElementById('detailDistance').textContent = ''; // Hide points for deals
      } else {
        document.getElementById('detailPriceArea').style.display = 'none';
      }

      // ── Show edit/delete buttons if owner ────────────────────────
      if (IS_OWNER) {
        var actionsDiv = document.getElementById('detailSwapBtn').parentElement;
        actionsDiv.insertAdjacentHTML('afterend',
          '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px">' +
          '<a href="/item/' + ITEM_ID + '/edit" class="btn btn-outline btn-lg">✏️ Edit</a>' +
          '<form method="POST" action="/item/' + ITEM_ID + '/delete" onsubmit="return confirm(\'Delete this item?\')">' +
          '<button type="submit" class="btn btn-lg w-full" style="background:#ef4444;color:#fff;border:none">🗑 Delete</button>' +
          '</form></div>'
        );
      }

      var reportBtn = document.getElementById('reportSellerBtn');
      if (reportBtn) {
        reportBtn.addEventListener('click', function () {
          var ownerId = '<%= item.creator ? item.creator._id : "" %>';
          var ownerName = '<%= item.creator ? item.creator.username : "" %>';
          if (window.SwapifyReport) {
            SwapifyReport.open({
              reportedUserId: ownerId,
              reportedUserName: ownerName,
              relatedListing: item.title,
              context: 'item-details'
            });
          }
        });
      }

      // ── AJAX Request Swap button (Member 4) ──────────────────────
      var swapBtn = document.getElementById('detailSwapBtn');
      var swapMsg = document.createElement('p');
      swapMsg.style.cssText = 'margin-top:8px;font-size:14px;font-weight:600;text-align:center';
      swapBtn.parentElement.after(swapMsg);

      if (!IS_LOGGED_IN) {
        swapBtn.addEventListener('click', function () {
          window.location.href = '/login';
        });
      } else if (IS_OWNER) {
        swapBtn.disabled = true;
        swapBtn.textContent = 'Your item';
      } else if (!ITEM_AVAILABLE) {
        swapBtn.disabled = true;
        swapBtn.textContent = 'Already Swapped';
      } else {
        swapBtn.addEventListener('click', function () {
          swapBtn.disabled = true;
          swapBtn.textContent = 'Requesting...';

          fetch('/swap/request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ requestedItemId: ITEM_ID })
          })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.success) {
              swapBtn.textContent = '✅ Swap Requested!';
              swapMsg.textContent = 'The item owner has been notified.';
              swapMsg.style.color = '#22c55e';
            } else {
              swapBtn.disabled = false;
              swapBtn.textContent = 'Request Swap';
              swapMsg.textContent = data.message || 'Something went wrong.';
              swapMsg.style.color = '#ef4444';
            }
          })
          .catch(function () {
            swapBtn.disabled = false;
            swapBtn.textContent = 'Request Swap';
            swapMsg.textContent = 'Network error. Please try again.';
            swapMsg.style.color = '#ef4444';
          });
        });
      }

      // ── Notification badge (Member 4) ────────────────────────────
      if (IS_LOGGED_IN) {
        fetch('/api/notifications/count')
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.count > 0) {
              // Find the notification bell link in the nav and badge it
              var bells = document.querySelectorAll('.notification-dot');
              bells.forEach(function (dot) {
                dot.textContent = data.count;
                dot.style.cssText = 'position:absolute;top:-6px;right:-6px;background:#ef4444;color:#fff;border-radius:50%;width:18px;height:18px;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;';
              });
            }
          })
          .catch(function () { /* silent fail */ });
      }

      // ── Responsive grid ─────────────────────────────────────────
      if (window.innerWidth < 768) document.getElementById('detailContent').style.gridTemplateColumns = '1fr';
    });
  </script>
  <style>@media(max-width:767px){#detailContent{grid-template-columns:1fr!important}}</style>
</body>
</html>

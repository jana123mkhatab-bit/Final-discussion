<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Skill Details — Swapify</title>
  <meta name="description" content="View skill swap details on Swapify.">
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="page-content">
  <section class="section" style="padding-top:32px">
    <div class="container" style="max-width:720px">
      <a href="/skills" class="btn btn-ghost btn-sm" style="margin-bottom:24px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> Back to Skills</a>

      <div id="skillContent">
        <!-- User Header -->
        <div class="card" style="padding:32px;margin-bottom:24px">
          <div class="flex items-center gap-4" style="margin-bottom:24px;flex-wrap:wrap">
            <a id="skillOwnerLink" href="#" style="display:block;flex-shrink:0;border-radius:50%;overflow:hidden;text-decoration:none" title="View profile">
              <img id="skillAvatar" src="" alt="" style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid var(--primary);display:block">
            </a>
            <div style="flex:1">
              <h1 style="font-size:28px;font-weight:700;margin-bottom:4px"><a id="skillUserNameLink" href="#" style="color:inherit;text-decoration:none" title="View profile"><span id="skillUserName"></span></a></h1>
              <div class="flex items-center gap-3" style="color:var(--muted-fg);font-size:14px;flex-wrap:wrap">
                <span class="flex items-center gap-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> <span id="skillLocation"></span></span>
                <span class="badge badge-outline" id="skillLevel"></span>
                <span class="item-card-rating"><svg viewBox="0 0 24 24" width="14" height="14"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> <span id="skillRating"></span></span>
              </div>
            </div>
          </div>

          <!-- Swap Box -->
          <div class="skill-swap-box" style="font-size:16px">
            <div><span class="label label-offers">OFFERS</span><span class="value" id="skillOffers" style="font-size:22px"></span></div>
            <div class="skill-swap-divider"><span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg></span></div>
            <div><span class="label label-requests">REQUESTS</span><span class="value" id="skillRequests" style="font-size:22px"></span></div>
          </div>
        </div>

        <!-- CV / Document Section -->
        <div id="cvSection" class="card" style="padding:20px;margin-bottom:16px;display:none;background:rgba(124,58,237,.02);border:1px dashed var(--border)">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
            <div style="display:flex;align-items:center;gap:12px">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--primary)"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <div>
                <div style="font-weight:600">Curriculum Vitae (CV)</div>
                <div style="color:var(--muted-fg);font-size:13px">Credentials and qualifications</div>
              </div>
            </div>
            <a href="" id="cvLink" target="_blank" class="btn btn-outline btn-sm" style="display:inline-flex;align-items:center;gap:6px">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              View Document
            </a>
          </div>
        </div>

        <div class="card" style="padding:16px;margin-bottom:16px" id="ratingBox" data-rating-box
          data-target-id="<%= item._id %>"
          data-target-model="Skill"
          data-owner-id="<%= item.creator ? item.creator._id : '' %>"
          data-current-user-id="<%= currentUser ? currentUser._id : '' %>"
          data-is-logged-in="<%= currentUser ? 'true' : 'false' %>">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <div>
              <div style="font-weight:600">Rate this skill</div>
              <div style="color:var(--muted-fg);font-size:13px">Average <span data-rating-avg>0.0</span> • <span data-rating-count>0</span> ratings</div>
            </div>
            <div class="rating-stars" style="display:flex;gap:6px">
              <button type="button" class="rating-star" data-score="1" aria-label="Rate 1 star"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
              <button type="button" class="rating-star" data-score="2" aria-label="Rate 2 stars"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
              <button type="button" class="rating-star" data-score="3" aria-label="Rate 3 stars"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
              <button type="button" class="rating-star" data-score="4" aria-label="Rate 4 stars"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
              <button type="button" class="rating-star" data-score="5" aria-label="Rate 5 stars"><svg viewBox="0 0 24 24" width="18" height="18"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>
            </div>
          </div>
          <textarea class="input" data-rating-comment rows="3" style="margin-top:12px" placeholder="Optional comment"></textarea>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-top:12px;gap:12px;flex-wrap:wrap">
            <button class="btn btn-outline btn-sm" data-rating-submit>Submit rating</button>
            <span class="rating-message" data-rating-msg style="font-size:12px;color:var(--muted-fg)"></span>
          </div>
        </div>

        <!-- Actions -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <button class="btn btn-primary btn-lg" id="swapSkillBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg>
            Request Skill Swap
          </button>
          <a href="/messages" id="msgBtn" class="btn btn-outline btn-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg>
            Message
          </a>
        </div>
        <button class="btn btn-ghost btn-sm" id="reportSkillUserBtn" style="margin-top:12px;color:var(--muted-fg);width:100%" aria-label="Report this user"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg> Report this user</button>
      </div>
    </div>
  </section>
  </div><!-- /.page-content -->

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo" style="margin-bottom:8px" aria-label="Swapify Home">
            <div class="logo-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg></div>
            <span class="logo-text"><span>Swapify</span></span>
          </a>
          <p>The cozy community marketplace where you can swap skills, trade items, and grab amazing half-price deals.</p>
          <div class="footer-social">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Facebook" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on X" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18"/><path d="M6 6L18 18"/></svg>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Instagram" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on LinkedIn" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>
        <div class="footer-col">
          <h4>About Swapify</h4>
          <ul>
            <li><a href="/about">About Swapify</a></li>
            <li><a href="/our-story">Our Story</a></li>
            <li><a href="/how-it-works">How it Works</a></li>
            <li><a href="/sustainability">Sustainability</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Community</h4>
          <ul>
            <li><a href="/guidelines">Guidelines</a></li>
            <li><a href="/success-stories">Success Stories</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Help Center</h4>
          <ul>
            <li><a href="/help-center">Help Center</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact Support</a></li>
            <li><a href="/trust-safety">Trust &amp; Safety</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Swapify. All rights reserved.</p>
        <div class="footer-tagline">
          <span>Less waste. More sharing.</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--primary)" stroke="var(--primary)" stroke-width="2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </div>
      </div>
    </div>
  </footer>

  <nav class="bottom-nav"><a href="/"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Home</span></a><a href="/skills" class="active"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg><span>Skills</span></a><a href="/add" class="add-btn"><div class="add-btn-circle"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg></div></a><a href="/messages"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg><span>Messages</span></a><a href="/profile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg><span>Profile</span></a></nav>

  <script src="/js/app.js"></script>
  <script src="/js/ratings.js"></script>
  <% if (locals.currentUser) { %>
  <script>
    (function() {
      var u = <%- JSON.stringify({ id: String(currentUser._id), email: currentUser.email, name: currentUser.username, role: currentUser.role || 'user' }) %>;
      SwapifyStore.setSession(u);
    })();
  </script>
  <% } %>
  <script src="/js/report-user.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var _item = <%- JSON.stringify({
        id:          String(item._id),
        ownerId:     String(item.creator._id),
        ownerName:   item.creator.username,
        ownerAvatar: item.creator.profileImage || '',
        title:       item.title,
        description: item.description || '',
        location:    (item.creator && item.creator.showLocation !== false) ? (item.itemLocation || 'Online') : 'Private',
        level:       item.level || 'Beginner',
        cachedRating: item.cachedRating || 0,
        cachedRatingCount: item.cachedRatingCount || 0,
        cvUrl:       item.cvUrl || ''
      }) %>;
      var _isLoggedIn    = <%- locals.currentUser ? 'true' : 'false' %>;
      var _currentUserId = '<%- locals.currentUser ? String(currentUser._id) : "" %>';

      var ownerLink = document.getElementById('skillOwnerLink');
      if (ownerLink && _item.ownerId) {
        ownerLink.href = '/users/' + _item.ownerId;
        ownerLink.title = 'View ' + _item.ownerName + "'s profile";
      }

      var userNameLink = document.getElementById('skillUserNameLink');
      if (userNameLink && _item.ownerId) {
        userNameLink.href = '/users/' + _item.ownerId;
        userNameLink.title = 'View ' + _item.ownerName + "'s profile";
      }

      document.getElementById('skillAvatar').src            = _item.ownerAvatar || '/img/stock_pfp.jpg';
      document.getElementById('skillAvatar').onerror        = function() { this.src = '/img/stock_pfp.jpg'; };
      document.getElementById('skillAvatar').alt            = _item.ownerName;
      document.getElementById('skillUserName').textContent  = _item.ownerName;
      document.getElementById('skillLocation').textContent  = _item.location;
      document.getElementById('skillLevel').textContent     = _item.level;
      if (_item.cvUrl) {
        var cvSec = document.getElementById('cvSection');
        var cvLnk = document.getElementById('cvLink');
        if (cvSec && cvLnk) {
          cvSec.style.display = 'block';
          cvLnk.href = _item.cvUrl;
        }
      }
      var skillRatingValue = parseFloat(_item.cachedRating) || 0;
      var skillRatingCount = parseInt(_item.cachedRatingCount, 10) || 0;
      document.getElementById('skillRating').textContent    = skillRatingCount ? skillRatingValue.toFixed(1) + ' (' + skillRatingCount + ')' : skillRatingValue.toFixed(1);
      document.getElementById('skillOffers').textContent    = _item.title;
      document.getElementById('skillRequests').textContent  = _item.description ? _item.description.substring(0, 60) : 'Open to swap';
      document.title = _item.title + ' — Swapify';

      var msgBtn = document.getElementById('msgBtn');
      if (msgBtn) msgBtn.href = '/messages?partner=' + _item.ownerId;

      var reportSkillBtn = document.getElementById('reportSkillUserBtn');
      if (reportSkillBtn) reportSkillBtn.addEventListener('click', function() {
        if (window.SwapifyReport) SwapifyReport.open({ reportedUserId: _item.ownerId, reportedUserName: _item.ownerName, relatedListing: _item.title, context: 'skill-details' });
      });

      var swapBtn = document.getElementById('swapSkillBtn');
      if (swapBtn) {
        swapBtn.addEventListener('click', function() {
          if (!_isLoggedIn) { window.location.href = '/login'; return; }
          if (_currentUserId === _item.ownerId) {
            if (window.SwapifyUI) SwapifyUI.toast('You cannot swap your own skill!', 'error');
            return;
          }
          if (window.SwapifyUI) SwapifyUI.toast('Swap requested! Opening chat 💬', 'success');
          swapBtn.disabled = true;
          swapBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Requested';
          swapBtn.classList.add('btn-swap-done');
          setTimeout(function() { window.location.href = '/messages?partner=' + _item.ownerId; }, 800);
        });
      }
    });
  </script>
</body>
</html>
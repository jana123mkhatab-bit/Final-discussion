<%
/**
 * Shared admin navbar partial.
 * Usage: include('../partials/admin-navbar', { activePage: 'users' })
 * activePage values: 'dashboard', 'users', 'skills', 'objects', 'deals', 'swaps', 'reports', 'logs', 'inbox'
 */
var _active = (typeof activePage !== 'undefined') ? activePage : '';
function _isActive(page) { return _active === page ? ' active' : ''; }
%>
<!-- Admin Logout Confirmation Modal -->
<div id="adminLogoutModal" style="display:none;position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.65);backdrop-filter:blur(5px);align-items:center;justify-content:center;">
  <div style="background:#1a1025;border:1px solid rgba(168,85,247,0.25);border-radius:20px;padding:32px 28px;width:90%;max-width:360px;box-shadow:0 24px 60px rgba(0,0,0,0.5);text-align:center;animation:logoutModalIn .25s ease">
    <div style="width:54px;height:54px;border-radius:50%;background:rgba(255,107,107,0.1);border:1px solid rgba(255,107,107,0.3);display:flex;align-items:center;justify-content:center;margin:0 auto 16px">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff6b6b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
    </div>
    <h3 style="font-size:1.1rem;font-weight:700;margin:0 0 8px;color:#fff">Sign out of Admin Panel?</h3>
    <p style="font-size:0.84rem;color:rgba(255,255,255,0.5);margin:0 0 24px">You'll be returned to the login page.</p>
    <div style="display:flex;gap:10px">
      <button id="adminLogoutCancelBtn" style="flex:1;padding:11px;border-radius:11px;border:1px solid rgba(255,255,255,0.12);background:transparent;color:#fff;font-size:0.87rem;font-weight:600;cursor:pointer;">Cancel</button>
      <button id="adminLogoutConfirmBtn" style="flex:1;padding:11px;border-radius:11px;border:none;background:linear-gradient(135deg,#dc2626,#ef4444);color:#fff;font-size:0.87rem;font-weight:700;cursor:pointer;">Sign Out</button>
    </div>
  </div>
</div>
<style>@keyframes logoutModalIn{from{opacity:0;transform:scale(.93) translateY(12px)}to{opacity:1;transform:scale(1) translateY(0)}}</style>
<script>
window.__SERVER_AUTH = true;
(function(){
  document.addEventListener('DOMContentLoaded', function(){
    var modal = document.getElementById('adminLogoutModal');
    var triggerBtn = document.getElementById('adminLogoutBtn');
    var cancelBtn = document.getElementById('adminLogoutCancelBtn');
    var confirmBtn = document.getElementById('adminLogoutConfirmBtn');
    if (!modal || !triggerBtn) return;
    triggerBtn.addEventListener('click', function(){ modal.style.display = 'flex'; });
    cancelBtn.addEventListener('click', function(){ modal.style.display = 'none'; });
    modal.addEventListener('click', function(e){ if (e.target === modal) modal.style.display = 'none'; });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') modal.style.display = 'none'; });
    confirmBtn.addEventListener('click', function(){
      confirmBtn.textContent = 'Signing out…';
      confirmBtn.disabled = true;
      if (typeof SwapifyAuth !== 'undefined') SwapifyAuth.logout();
    });
  });
})();
</script>

<header class="header"><div class="container header-inner">
  <a href="/" class="logo"><div class="logo-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg></div><span class="logo-text"><span>Swapify</span></span></a>
  <nav class="nav">
    <a href="/admin"                class="nav-link<%- _isActive('dashboard') %>">Dashboard</a>
    <a href="/admin/users"          class="nav-link<%- _isActive('users') %>">Users</a>
    <a href="/admin/skills"         class="nav-link<%- _isActive('skills') %>">Skills</a>
    <a href="/admin/objects"        class="nav-link<%- _isActive('objects') %>">Objects</a>
    <a href="/admin/deals"          class="nav-link<%- _isActive('deals') %>">Deals</a>
    <a href="/admin/swaps"          class="nav-link<%- _isActive('swaps') %>">Swaps</a>
    <a href="/admin/reports"        class="nav-link<%- _isActive('reports') %>">Reports</a>
    <a href="/admin/logs"           class="nav-link<%- _isActive('logs') %>">Logs</a>
    <a href="/admin/contact-messages" class="nav-link<%- _isActive('inbox') %>">Inbox</a>
  </nav>
  <div class="header-actions">
    <span class="badge badge-primary" style="font-size:11px">ADMIN</span>
    <button class="btn btn-ghost btn-sm rounded-full" id="themeToggle" onclick="toggleTheme()">🌙</button>
    <button class="btn btn-ghost btn-sm" id="adminLogoutBtn"
      style="color:#ff6b6b;border:1px solid rgba(255,107,107,.3);border-radius:10px;padding:6px 14px;font-size:12px;font-weight:700">⏏ Logout</button>
  </div>
</div></header>

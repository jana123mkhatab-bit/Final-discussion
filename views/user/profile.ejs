<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile — Swapify</title>
  <meta name="description" content="Your Swapify profile. Manage your skills, items, deals, and swap requests.">
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
  <style>
    /* ── My Skills Table ── */
    .ms-table {
      width: 100%;
      border-collapse: collapse;
    }

    .ms-table th {
      text-align: left;
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 600;
      color: var(--muted-fg);
      border-bottom: 2px solid var(--border);
    }

    .ms-table td {
      padding: 13px 16px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    .ms-table tr:last-child td {
      border-bottom: none;
    }

    .ms-table tr:hover td {
      background: var(--muted);
      transition: background .15s;
    }

    .cert-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(76, 175, 122, .12);
      color: var(--success);
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    /* ── Trust Progress Bar ── */
    .trust-progress {
      margin-top: 14px;
    }

    .trust-bar-wrap {
      background: var(--border);
      border-radius: 20px;
      height: 8px;
      overflow: hidden;
      margin-top: 6px;
    }

    .trust-bar-fill {
      height: 100%;
      border-radius: 20px;
      background: linear-gradient(90deg, var(--primary), #a78bfa);
      transition: width .7s ease;
    }

    /* ── Overlays / Modals ── */
    .sk-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .55);
      backdrop-filter: blur(5px);
      z-index: 2000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .sk-overlay.open {
      display: flex;
    }

    .sk-modal {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px;
      width: 100%;
      max-width: 480px;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
      animation: modalIn .25s ease;
    }

    @keyframes modalIn {
      from {
        opacity: 0;
        transform: translateY(20px) scale(.97)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    .sk-modal h3 {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .sk-modal .sub {
      font-size: 14px;
      color: var(--muted-fg);
      margin-bottom: 20px;
    }

    .sk-modal-close {
      position: absolute;
      top: 14px;
      right: 16px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--muted-fg);
      font-size: 24px;
      line-height: 1;
      padding: 4px;
    }

    .sk-modal-close:hover {
      color: var(--fg);
    }

    /* ── Star Rating Input ── */
    .star-row {
      display: flex;
      flex-direction: row-reverse;
      justify-content: flex-end;
      gap: 4px;
      margin: 8px 0 4px;
    }

    .star-row input[type=radio] {
      display: none;
    }

    .star-row label {
      font-size: 26px;
      cursor: pointer;
      color: var(--border);
      transition: color .12s;
    }

    .star-row input:checked~label,
    .star-row label:hover,
    .star-row label:hover~label {
      color: #f59e0b;
    }

    /* ── Form helpers ── */
    .field-err {
      display: block;
      font-size: 12px;
      color: #ef4444;
      margin-top: 4px;
      min-height: 16px;
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar') %>

  <!-- COVER PHOTO -->
  <div class="profile-cover"></div>

  <!-- PROFILE CONTENT -->
  <div class="container" style="padding-bottom:120px">

    <!-- Profile Card -->
    <div class="profile-card fade-in" style="margin-bottom:48px">
      <div class="profile-avatar">
        <img src="" id="profileMainAvatar" alt="Profile" class="avatar-xl"
          style="width:160px;height:160px;border-radius:50%;border:4px solid var(--bg);object-fit:cover;box-shadow:var(--shadow-lg);background:var(--muted)">
        <!-- Verified shield — hidden by default; JS shows after 50 swaps -->
        <div class="profile-verified" id="profileVerifiedBadge" style="display:none"><svg width="20" height="20"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m9 12 2 2 4-4" />
          </svg></div>
      </div>
      <div class="profile-info">
        <div class="flex justify-between items-center" style="flex-wrap:wrap;gap:16px">
          <div>
            <h1 class="profile-name" id="profileName">Loading...</h1>
            <p class="profile-handle" id="profileHandle"></p>
          </div>
          <div class="flex gap-3">
            <a href="/settings" class="btn btn-outline"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <path
                  d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg> Edit Profile</a>
            <a href="/favorites" class="btn btn-primary"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <path
                  d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
              </svg> My Favorites</a>
          </div>
        </div>
        <p class="profile-bio">Sustainability enthusiast, amateur photographer, and language learner. Always looking to
          swap knowledge and cool vintage finds! 🌿📸</p>
        <div class="profile-details">
          <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg> Brooklyn, NY</span>
          <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
              <line x1="16" x2="16" y1="2" y2="6" />
              <line x1="8" x2="8" y1="2" y2="6" />
              <line x1="3" x2="21" y1="10" y2="10" />
            </svg> Joined Mar 2023</span>
          <!-- Trusted Swapper — shown by JS only when swap count >= 50 -->
          <span id="trustedSwapperBadge" style="display:none;color:var(--success);font-weight:500"><svg width="16"
              height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <path d="m9 11 3 3L22 4" />
            </svg> Trusted Swapper</span>
        </div>
        <% if (currentUser && currentUser.isBanned) { %>
          <div style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:12px;padding:14px 18px;margin-top:16px;display:flex;align-items:flex-start;gap:12px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            <div>
              <div style="font-weight:700;color:#ef4444;font-size:14px">Account Suspended</div>
              <div style="font-size:13px;color:var(--muted-fg);margin-top:2px">Your account has been suspended. Contact support for assistance.</div>
            </div>
          </div>
        <% } %>
        <!-- Trust Progress Bar (hidden when trusted) -->
        <div class="trust-progress" id="trustProgressWrap">
          <div
            style="display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--muted-fg)">
            <span>🏅 Progress to <strong style="color:var(--fg)">Trusted Swapper</strong></span>
            <span id="trustProgressLabel">0 / 50 swaps</span>
          </div>
          <div class="trust-bar-wrap">
            <div class="trust-bar-fill" id="trustBarFill" style="width:0%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- TABS -->
    <div class="tabs hide-scrollbar">
      <button class="tab active" data-tab="myskills">My Skills</button>
      <button class="tab" data-tab="items">My Items</button>
      <button class="tab owner-tab" data-tab="deals">My Deals</button>
      <button class="tab owner-tab" data-tab="history">Purchase History</button>
      <button class="tab owner-tab" data-tab="wallet">Wallet</button>
    </div>

    <!-- ═══════════════════════════════════════════
         TAB: MY SKILLS (new — personal skill registry)
    ═══════════════════════════════════════════ -->
    <div class="tab-content active" id="tab-myskills">
      <div
        style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px">
        <h2 style="font-size:24px;font-weight:700">My Skills</h2>
        <button class="btn btn-primary owner-action" id="addMySkillBtn" style="display:none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14" />
            <path d="M12 5v14" />
          </svg>
          Add Skill
        </button>
      </div>
      <div id="mySkillsContent"><!-- filled by JS --></div>
    </div>

    <!-- ═══════════════════════════════════════════
         TAB: MY ITEMS (no default items)
    ═══════════════════════════════════════════ -->
    <div class="tab-content" id="tab-items">
      <div
        style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px">
        <h2 style="font-size:24px;font-weight:700">My Items</h2>
        <a href="/add" class="btn btn-primary owner-action" id="listItemBtn" style="display:none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14" />
            <path d="M12 5v14" />
          </svg>
          List an Item
        </a>
      </div>
      <div id="myItemsContent"><!-- filled by JS --></div>
    </div>

    <!-- ═══════════════════════════════════════════
         TAB: MY DEALS (owner only)
    ═══════════════════════════════════════════ -->
    <div class="tab-content owner-tab" id="tab-deals">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px">
        <h2 style="font-size:24px;font-weight:700">My Deals</h2>
        <a href="/add?type=deal" class="btn btn-primary owner-action" id="listDealBtn" style="display:none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14" />
            <path d="M12 5v14" />
          </svg>
          List a Deal
        </a>
      </div>
      <div id="myDealsContent"><!-- filled by JS --></div>
    </div>

    <!-- ═══════════════════════════════════════════
         TAB: PURCHASE HISTORY (owner only)
    ═══════════════════════════════════════════ -->
    <div class="tab-content owner-tab" id="tab-history">
      <div class="empty-state">
        <div class="empty-state-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none"
            stroke="var(--muted-fg)" stroke-width="2">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg></div>
        <h3>No history yet</h3>
        <p>When you have activity here, it will show up.</p><a href="/" class="btn btn-primary">Explore Community</a>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════
         TAB: WALLET (owner only)
    ═══════════════════════════════════════════ -->
    <div class="tab-content owner-tab" id="tab-wallet">
      <h2 style="font-size:24px;font-weight:700;margin-bottom:24px;font-family:var(--font-heading)">My Wallet</h2>
      <div class="grid grid-2 gap-6" style="margin-bottom:32px">
        <div class="card"
          style="padding:24px;background:linear-gradient(135deg,rgba(124,58,237,.05),rgba(37,99,235,.05));border:1px solid rgba(124,58,237,.2);position:relative;overflow:hidden">
          <div
            style="position:absolute;top:-20px;right:-20px;width:120px;height:120px;background:radial-gradient(circle,rgba(124,58,237,.1) 0%,transparent 70%);border-radius:50%">
          </div>
          <div class="font-bold text-muted-fg mb-2" style="position:relative;z-index:1">Available Points</div>
          <div class="flex items-center gap-2"
            style="font-size:36px;font-weight:800;color:var(--primary);position:relative;z-index:1;font-family:var(--font-heading)">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
            <span id="walletPointsVal">0</span>
          </div>
          <p class="text-sm mt-2 text-muted-fg" style="position:relative;z-index:1;font-weight:500">Equivalent to $<span
              id="walletPointsCash">0.00</span> in store credit</p>
          <div style="margin-top:20px;position:relative;z-index:1"><button class="btn btn-primary w-full"
              onclick="window.location= '/deals'">Shop Deals &amp; Earn Points</button></div>
        </div>
        <div id="walletCardsContainer">
          <div style="color:var(--muted-fg);font-size:14px;text-align:center;padding:16px">Loading saved cards…</div>
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;margin-bottom:24px">
        <button class="btn btn-outline" onclick="document.getElementById('addCardModal').classList.add('open')" style="display:flex;align-items:center;gap:6px">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Card
        </button>
      </div>
      <h3 style="font-size:18px;font-weight:700;margin-bottom:16px;font-family:var(--font-heading)">Recent Transactions
      </h3>
      <div id="walletRecentTransactions"></div>
    </div>

  </div><!-- /container -->

  <!-- ═══════════════════════════════════════════
       MODAL: ADD / EDIT MY SKILL
  ═══════════════════════════════════════════ -->
  <div class="sk-overlay" id="mySkillModal">
    <div class="sk-modal">
      <button class="sk-modal-close" onclick="closeModal('mySkillModal')">&times;</button>
      <h3 id="mySkillModalTitle">Add Skill</h3>
      <p class="sub">Tell us about a skill you have.</p>
      <input type="hidden" id="editSkillId">

      <div class="form-group">
        <label class="form-label">Skill Name *</label>
        <input type="text" class="input" id="skillNameInput" placeholder="e.g. Photography, Spanish, Web Design">
        <span class="field-err" id="skillNameErr"></span>
      </div>

      <div class="form-group">
        <label class="form-label">Your Self-Rating (1–5 stars) *</label>
        <div class="star-row" id="starRatingInput">
          <input type="radio" name="skillRating" id="sr5" value="5"><label for="sr5" title="5 stars">★</label>
          <input type="radio" name="skillRating" id="sr4" value="4"><label for="sr4" title="4 stars">★</label>
          <input type="radio" name="skillRating" id="sr3" value="3"><label for="sr3" title="3 stars">★</label>
          <input type="radio" name="skillRating" id="sr2" value="2"><label for="sr2" title="2 stars">★</label>
          <input type="radio" name="skillRating" id="sr1" value="1"><label for="sr1" title="1 star">★</label>
        </div>
        <span class="field-err" id="skillRatingErr"></span>
      </div>

      <div class="form-group">
        <label class="form-label">Certification <span
            style="color:var(--muted-fg);font-weight:400">(optional)</span></label>
        <input type="text" class="input" id="skillCertInput" placeholder="Certificate name or link to proof">
        <p style="font-size:12px;color:var(--muted-fg);margin-top:4px">Add a certification title or URL to show proof of
          your skill</p>
      </div>

      <div style="display:flex;gap:12px;margin-top:8px">
        <button class="btn btn-primary" style="flex:1" id="saveMySkillBtn">Save Skill</button>
        <button class="btn btn-ghost" onclick="closeModal('mySkillModal')">Cancel</button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       MODAL: ADD CARD TO WALLET
  ═══════════════════════════════════════════ -->
  <div class="sk-overlay" id="addCardModal">
    <div class="sk-modal">
      <button class="sk-modal-close" onclick="document.getElementById('addCardModal').classList.remove('open')">&times;</button>
      <h3>Add a Card</h3>
      <p class="sub">Your card number is encrypted and stored securely.</p>

      <div class="form-group">
        <label class="form-label">Cardholder Name *</label>
        <input type="text" class="input" id="acCardName" placeholder="e.g. Jane Doe" oninput="document.getElementById('acCardNameErr').textContent=''"  autocomplete="cc-name">
        <span class="field-err" id="acCardNameErr"></span>
      </div>

      <div class="form-group">
        <label class="form-label">Card Number *</label>
        <input type="text" class="input" id="acCardNumber" placeholder="0000 0000 0000 0000" maxlength="23" oninput="acFormatCardNumber(this)">
        <span class="field-err" id="acCardNumberErr"></span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div class="form-group">
          <label class="form-label">Expiry *</label>
          <input type="text" class="input" id="acCardExpiry" placeholder="MM/YY" maxlength="5" oninput="acFormatExpiry(this)">
          <span class="field-err" id="acCardExpiryErr"></span>
        </div>
        <div class="form-group">
          <label class="form-label">CVV *</label>
          <input type="password" class="input" id="acCardCvv" placeholder="123" maxlength="4" inputmode="numeric" oninput="acFormatCvv(this)">
          <span class="field-err" id="acCardCvvErr"></span>
        </div>
      </div>

      <div id="acCardError" style="display:none;color:var(--error);font-size:13px;margin-bottom:8px"></div>

      <div style="display:flex;gap:12px;margin-top:8px">
        <button class="btn btn-primary" style="flex:1" id="saveCardBtn" onclick="submitAddCard()">Save Card</button>
        <button class="btn btn-ghost" onclick="document.getElementById('addCardModal').classList.remove('open')">Cancel</button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       OVERLAY: CONFIRM CARD REMOVAL
  ═══════════════════════════════════════════ -->
  <div id="walletDeleteOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(5px);z-index:3000;align-items:center;justify-content:center;padding:16px">
    <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:32px 28px;width:100%;max-width:360px;text-align:center;animation:modalIn .22s ease">
      <div style="width:52px;height:52px;background:rgba(239,68,68,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="m19 6-.867 12.142A2 2 0 0 1 16.138 20H7.862a2 2 0 0 1-1.995-1.858L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
      </div>
      <h3 style="font-size:18px;font-weight:700;margin-bottom:8px">Remove Card?</h3>
      <p id="walletDeleteMsg" style="font-size:14px;color:var(--muted-fg);margin-bottom:24px;line-height:1.5"></p>
      <div style="display:flex;gap:12px">
        <button onclick="window._wConfirmDelete()" class="btn btn-primary" style="flex:1;background:#ef4444;border-color:#ef4444">Yes, Remove</button>
        <button onclick="document.getElementById('walletDeleteOverlay').style.display='none'" class="btn btn-ghost" style="flex:1">Cancel</button>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo" style="margin-bottom:8px" aria-label="Swapify Home">
            <div class="logo-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" aria-hidden="true">
                <path d="M8 3L4 7l4 4" />
                <path d="M4 7h16" />
                <path d="M16 21l4-4-4-4" />
                <path d="M20 17H4" />
              </svg></div><span class="logo-text"><span>Swapify</span></span>
          </a>
          <p>The cozy community marketplace where you can swap skills, trade items, and grab amazing half-price deals.
          </p>
          <div class="footer-social">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer"
              aria-label="Follow Swapify on Facebook" class="social-link"><svg width="20" height="20"
                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">

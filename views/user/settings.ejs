<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings — Swapify</title>
  <meta name="description" content="Manage your Swapify account settings.">
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container" style="padding-top:32px;padding-bottom:80px">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;margin-bottom:16px">
      <div>
        <h1 style="font-size:32px;font-weight:700;margin-bottom:4px">Settings</h1>
        <p style="color:var(--muted-fg);margin-bottom:0">Manage your account and preferences</p>
      </div>
      <a href="/profile" class="btn btn-outline btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 5-7 7 7 7"/></svg>
        Back to Profile
      </a>
    </div>

    <div class="settings-layout">
      <!-- Sidebar Nav -->
      <nav class="settings-nav">
        <a href="#account" class="active"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg> Account</a>
        <a href="#appearance"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg> Appearance</a>
        <a href="#notifications"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg> Notifications</a>
        <a href="#privacy"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Privacy</a>
      </nav>

      <!-- Settings Content -->
      <div>
        <!-- Account -->
        <div class="settings-section" style="margin-bottom:24px" id="account">
          <h2>Account Settings</h2>
          <% if (typeof error !== 'undefined' && error) { %>
            <div style="background:var(--error);color:#fff;padding:12px 16px;border-radius:var(--radius-md);margin-bottom:16px;font-size:14px"><%= error %></div>
          <% } %>
          <% if (typeof success !== 'undefined' && success) { %>
            <div style="background:var(--success);color:#fff;padding:12px 16px;border-radius:var(--radius-md);margin-bottom:16px;font-size:14px"><%= success %></div>
          <% } %>
          <!-- Avatar upload (separate request, no page reload) -->
          <div style="margin-bottom:28px;padding-bottom:24px;border-bottom:1px solid var(--border)">
            <label style="display:block;font-weight:600;margin-bottom:12px">Profile Picture</label>
            <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
              <img id="avatarPreview"
                   src="<%= user.profileImage || '/img/stock_pfp.jpg' %>"
                   alt="Profile picture"
                   style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:2px solid var(--border);background:var(--muted)">
              <div>
                <label for="avatarInput" class="btn btn-outline" style="cursor:pointer;margin-bottom:6px">
                  Choose Photo
                  <input type="file" id="avatarInput" accept=".jpg,.jpeg,.png,.webp" style="display:none">
                </label>
                <p class="text-sm" style="color:var(--muted-fg);font-size:12px;margin:0">JPG, PNG or WEBP · max 5 MB</p>
                <p id="avatarStatus" style="font-size:12px;margin-top:4px;min-height:16px"></p>
              </div>
            </div>
          </div>

          <form id="settingsForm" action="/settings" method="post">
            <div class="form-group" style="margin-bottom:20px">
              <label>Username</label>
              <input type="text" class="input" id="settingsName" name="username" placeholder="Your username" value="<%= user.username %>" required>
            </div>
            <div class="form-group" style="margin-bottom:20px">
              <label>Email</label>
              <input type="email" class="input" id="settingsEmail" name="email" placeholder="your@email.com" value="<%= user.email %>" required>
            </div>
            <div class="form-group" style="margin-bottom:20px">
              <label>Location</label>
              <input type="text" class="input" id="settingsLocation" name="location" placeholder="City, Country" value="<%= user.location || '' %>">
            </div>
            <div class="form-group" style="margin-bottom:20px">
              <label>Bio <span style="color:var(--muted-fg);font-weight:400;font-size:13px">(max 500 characters)</span></label>
              <textarea class="input" name="bio" rows="3" maxlength="500"
                        placeholder="Tell the community a bit about yourself…"
                        style="resize:vertical"><%= user.bio || '' %></textarea>
            </div>
            <div class="form-group" style="margin-bottom:20px">
              <label>New Password</label>
              <input type="password" class="input" name="newPassword" placeholder="Leave blank to keep current">
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </form>

          <script>
          (function () {
            var input    = document.getElementById('avatarInput');
            var preview  = document.getElementById('avatarPreview');
            var status   = document.getElementById('avatarStatus');

            if (!input) return;

            input.addEventListener('change', function () {
              var file = input.files && input.files[0];
              if (!file) return;

              // Show a local preview immediately
              var reader = new FileReader();
              reader.onload = function (e) { preview.src = e.target.result; };
              reader.readAsDataURL(file);

              // Upload to the server
              status.style.color = 'var(--muted-fg)';
              status.textContent  = 'Uploading…';

              var fd = new FormData();
              fd.append('avatar', file);

              fetch('/profile/avatar', { method: 'POST', body: fd })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                  if (data.success) {
                    status.style.color = 'var(--success)';
                    status.textContent  = 'Profile picture saved!';
                    // Update every avatar image on the page
                    document.querySelectorAll('.profile-ring img, #headerAvatarImg')
                      .forEach(function (img) { img.src = data.imageUrl; });
                  } else {
                    status.style.color = '#ef4444';
                    status.textContent  = data.error || 'Upload failed.';
                  }
                })
                .catch(function () {
                  status.style.color = '#ef4444';
                  status.textContent  = 'Network error — please try again.';
                });
            });
          })();
          </script>
          <div style="margin-top:24px;padding-top:24px;border-top:1px solid var(--border)">
            <button class="btn btn-outline" style="color:var(--error);border-color:var(--error)" id="logoutBtn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
              Log Out
            </button>
          </div>
        </div>

        <!-- Appearance -->
        <div class="settings-section" style="margin-bottom:24px" id="appearance">
          <h2>Appearance</h2>
          <div class="toggle-row">
            <div><h4 style="font-weight:600">Dark Mode</h4><p class="text-sm" style="color:var(--muted-fg)">Switch between light and dark theme</p></div>
            <div class="toggle" id="darkModeToggle"></div>
          </div>
        </div>

        <!-- Notifications -->
        <div class="settings-section" style="margin-bottom:24px" id="notifications">
          <h2>Notifications</h2>
          <div class="toggle-row"><div><h4 style="font-weight:600">Email Notifications</h4><p class="text-sm" style="color:var(--muted-fg)">Receive email updates about your swaps</p></div><div class="toggle active"></div></div>
          <div class="toggle-row"><div><h4 style="font-weight:600">Push Notifications</h4><p class="text-sm" style="color:var(--muted-fg)">Get push notifications for new messages</p></div><div class="toggle active"></div></div>
          <div class="toggle-row"><div><h4 style="font-weight:600">Marketing Emails</h4><p class="text-sm" style="color:var(--muted-fg)">Receive newsletters and promotions</p></div><div class="toggle"></div></div>
          <div class="toggle-row"><div><h4 style="font-weight:600">Login Alerts</h4><p class="text-sm" style="color:var(--muted-fg)">Get notified when someone logs into your account</p></div><div class="toggle active"></div></div>
        </div>

        <!-- Privacy -->
        <div class="settings-section" style="margin-bottom:24px" id="privacy">
          <h2>Privacy</h2>
          <div class="toggle-row"><div><h4 style="font-weight:600">Profile Visibility</h4><p class="text-sm" style="color:var(--muted-fg)">Make your profile visible to other users</p></div><div class="toggle <%= user.profileVisibility !== false ? 'active' : '' %>" id="privacyProfileVisibility"></div></div>
          <div class="toggle-row"><div><h4 style="font-weight:600">Show Location</h4><p class="text-sm" style="color:var(--muted-fg)">Display your approximate location on listings</p></div><div class="toggle <%= user.showLocation !== false ? 'active' : '' %>" id="privacyShowLocation"></div></div>
          <div class="toggle-row"><div><h4 style="font-weight:600">Online Status</h4><p class="text-sm" style="color:var(--muted-fg)">Show when you're online</p></div><div class="toggle" id="settingsOnlineToggle"></div></div>
        </div>

        <!-- Security section removed -->
      </div>
    </div>
  </div>

  <!-- FOOTER -->
    <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo" style="margin-bottom:8px" aria-label="Swapify Home">
            <div class="logo-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg></div>
            <span class="logo-text"><span>Swapify</span></span>
          </a>
          <p>The cozy community marketplace where you can swap skills, trade items, and grab amazing half-price deals.</p>
          <div class="footer-social">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Facebook" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on X" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18"/><path d="M6 6L18 18"/></svg>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Instagram" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on LinkedIn" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>
        <div class="footer-col">
          <h4>About Swapify</h4>
          <ul>
            <li><a href="/about">About Swapify</a></li>
            <li><a href="/our-story">Our Story</a></li>
            <li><a href="/how-it-works">How it Works</a></li>
            <li><a href="/sustainability">Sustainability</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Community</h4>
          <ul>
            <li><a href="/guidelines">Guidelines</a></li>
            <li><a href="/success-stories">Success Stories</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Help Center</h4>
          <ul>
            <li><a href="/help-center">Help Center</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact Support</a></li>
            <li><a href="/trust-safety">Trust &amp; Safety</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Swapify. All rights reserved.</p>
        <div class="footer-tagline">
          <span>Less waste. More sharing.</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--primary)" stroke="var(--primary)" stroke-width="2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </div>
      </div>
    </div>
  </footer>

  <nav class="bottom-nav"><a href="/"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Home</span></a><a href="/skills"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg><span>Skills</span></a><a href="/add" class="add-btn"><div class="add-btn-circle"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg></div></a><a href="/messages"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg><span>Messages</span></a><a href="/profile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg><span>Profile</span></a></nav>

  <script src="/js/app.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Set dark mode toggle state
      var toggle = document.getElementById('darkModeToggle');
      if (toggle && document.documentElement.classList.contains('dark')) toggle.classList.add('active');

      // Settings nav + section switching
      var settingsLinks = document.querySelectorAll('.settings-nav a');
      var settingsSections = document.querySelectorAll('.settings-section');

      function showSettingsSection(sectionId) {
        if (!sectionId) return;
        settingsSections.forEach(function(section) {
          section.style.display = section.id === sectionId ? 'block' : 'none';
        });
        settingsLinks.forEach(function(link) {
          var targetId = link.getAttribute('href').slice(1);
          link.classList.toggle('active', targetId === sectionId);
        });
      }

      function resolveSectionFromHash() {
        var hash = window.location.hash ? window.location.hash.slice(1) : '';
        if (hash && document.getElementById(hash)) return hash;
        return document.getElementById('account') ? 'account' : (settingsSections[0] ? settingsSections[0].id : '');
      }

      showSettingsSection(resolveSectionFromHash());

      settingsLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
          var targetId = link.getAttribute('href').slice(1);
          if (!targetId) return;
          e.preventDefault();
          history.replaceState(null, '', '#' + targetId);
          showSettingsSection(targetId);
        });
      });

      window.addEventListener('hashchange', function() {
        showSettingsSection(resolveSectionFromHash());
      });

      // Logout handled by global script in /js/app.js (adds confirmation)

      // Privacy Settings toggles submission
      var profileVisToggle = document.getElementById('privacyProfileVisibility');
      var showLocToggle = document.getElementById('privacyShowLocation');

      function updatePrivacySettings() {
        var profileVisibility = profileVisToggle ? profileVisToggle.classList.contains('active') : true;
        var showLocation = showLocToggle ? showLocToggle.classList.contains('active') : true;

        fetch('/settings/privacy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ profileVisibility: profileVisibility, showLocation: showLocation })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.success) {
            console.error('Failed to update privacy settings:', d.error);
          }
        })
        .catch(function(err) {
          console.error('Network error updating privacy settings:', err);
        });
      }

      if (profileVisToggle) {
        profileVisToggle.addEventListener('click', function() {
          setTimeout(updatePrivacySettings, 50);
        });
      }

      if (showLocToggle) {
        showLocToggle.addEventListener('click', function() {
          setTimeout(updatePrivacySettings, 50);
        });
      }
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Swap Requests — Swapify</title>
  <meta name="description" content="Manage all your skill and object swap requests on Swapify.">
  <link rel="stylesheet" href="/css/main.css?v=2026052318">
  <style>
    .sr-filter-bar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .sr-filter-btn {
      padding: 6px 16px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--muted-fg);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all .15s;
    }
    .sr-filter-btn.active,
    .sr-filter-btn:hover {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }
    .sr-type-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 10px;
      border-radius: 999px;
      margin-bottom: 6px;
    }
    .sr-type-skill  { background: rgba(124,58,237,.12); color: var(--primary); border: 1px solid rgba(124,58,237,.3); }
    .sr-type-object { background: rgba(37,99,235,.12);  color: #2563eb;        border: 1px solid rgba(37,99,235,.3);  }
    .sr-dir-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--muted);
      color: var(--muted-fg);
      margin-left: 6px;
    }
  </style>
</head>
<body>

  <%- include('../partials/navbar') %>

  <!-- PAGE CONTENT -->
  <section class="section" style="padding-top:40px">
    <div class="container" style="max-width:800px;padding-bottom:100px">

      <!-- Page header -->
      <div class="flex justify-between items-center" style="margin-bottom:32px;flex-wrap:wrap;gap:12px">
        <div>
          <h1 style="font-size:32px;font-weight:700;margin-bottom:4px">Swap Requests</h1>
          <p style="color:var(--muted-fg)" id="srSubtitle">Loading…</p>
        </div>
        <a href="/profile" class="btn btn-outline btn-sm">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 5-7 7 7 7"/></svg>
          Back to Profile
        </a>
      </div>

      <!-- Filter bar -->
      <div class="sr-filter-bar">
        <button class="sr-filter-btn active" data-filter="all">All</button>
        <button class="sr-filter-btn" data-filter="skill">Skill Swaps</button>
        <button class="sr-filter-btn" data-filter="object">Object Swaps</button>
        <button class="sr-filter-btn" data-filter="incoming">Incoming</button>
        <button class="sr-filter-btn" data-filter="outgoing">Outgoing</button>
        <button class="sr-filter-btn" data-filter="pending">Pending</button>
        <button class="sr-filter-btn" data-filter="accepted">Accepted</button>
        <button class="sr-filter-btn" data-filter="rejected">Rejected</button>
      </div>

      <!-- Swap list -->
      <div id="srList"></div>

      <!-- Empty state (hidden until needed) -->
      <div id="srEmpty" style="display:none">
        <div class="empty-state">
          <div class="empty-state-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--muted-fg)" stroke-width="2">
              <path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/>
            </svg>
          </div>
          <h3 id="srEmptyTitle">No swap requests yet</h3>
          <p id="srEmptyMsg">Start exploring the community to find your next great swap!</p>
          <a href="/skills" class="btn btn-primary">Explore Skills</a>
        </div>
      </div>

    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo" style="margin-bottom:8px" aria-label="Swapify Home">
            <div class="logo-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg></div>
            <span class="logo-text"><span>Swapify</span></span>
          </a>
          <p>The cozy community marketplace where you can swap skills, trade items, and grab amazing half-price deals.</p>
          <div class="footer-social">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Facebook" class="social-link"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on X" class="social-link"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18"/><path d="M6 6L18 18"/></svg></a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on Instagram" class="social-link"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="Follow Swapify on LinkedIn" class="social-link"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></a>
          </div>
        </div>
        <div class="footer-col">
          <h4>About Swapify</h4>
          <ul>
            <li><a href="/about">About Swapify</a></li>
            <li><a href="/our-story">Our Story</a></li>
            <li><a href="/how-it-works">How it Works</a></li>
            <li><a href="/sustainability">Sustainability</a></li>

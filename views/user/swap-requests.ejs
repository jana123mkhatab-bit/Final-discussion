      <div class="footer-bottom">
        <p>&copy; 2026 Swapify. All rights reserved.</p>
        <div class="footer-tagline">
          <span>Less waste. More sharing.</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--primary)" stroke="var(--primary)" stroke-width="2" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </div>
      </div>
    </div>
  </footer>

  <!-- MOBILE BOTTOM NAV -->
  <nav class="bottom-nav">
    <a href="/"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Home</span></a>
    <a href="/skills"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg><span>Skills</span></a>
    <a href="/add" class="add-btn"><div class="add-btn-circle"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg></div></a>
    <a href="/messages"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg><span>Messages</span></a>
    <a href="/profile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg><span>Profile</span></a>
  </nav>

  <!-- Server data island -->
  <script type="application/json" id="__srSwapsData"><%- JSON.stringify((userSwaps || []).map(function(sw) {
    var uid = currentUserId || '';
    var isIncoming = sw.receiver && String(sw.receiver._id) === uid;
    var offeredLabel  = sw.swapType === 'object'
      ? (sw.offeredItem   ? sw.offeredItem.title   : (sw.offeredItemName   || '(open offer)'))
      : (sw.offeredSkill  ? sw.offeredSkill.title  : (sw.offeredSkillName  || 'Unknown skill'));
    var requestedLabel = sw.swapType === 'object'
      ? (sw.requestedItem ? sw.requestedItem.title : (sw.requestedItemName  || 'Unknown item'))
      : (sw.requestedSkill ? sw.requestedSkill.title : (sw.requestedSkillName || 'Unknown skill'));
    return {
      id:             String(sw._id),
      swapType:       sw.swapType || 'skill',
      status:         sw.status,
      isIncoming:     isIncoming,
      requesterId:    sw.requester ? String(sw.requester._id) : '',
      requesterName:  sw.requester ? sw.requester.username  : 'Unknown',
      requesterAvatar:sw.requester ? (sw.requester.profileImage || '') : '',
      receiverId:     sw.receiver  ? String(sw.receiver._id)  : '',
      receiverName:   sw.receiver  ? sw.receiver.username   : 'Unknown',
      receiverAvatar: sw.receiver  ? (sw.receiver.profileImage  || '') : '',
      offeredLabel:   offeredLabel,
      requestedLabel: requestedLabel,
      offeredItemName:    sw.offeredItemName    || '',
      requestedItemName:  sw.requestedItemName  || '',
      offeredSkillName:   sw.offeredSkillName   || '',
      requestedSkillName: sw.requestedSkillName || '',
      createdAt:      sw.createdAt
    };
  })) %></script>

  <script src="/js/app.js"></script>
  <script>
    (function () {
      var DEFAULT_AVA = '/img/stock_pfp.jpg';
      var allSwaps = JSON.parse(document.getElementById('__srSwapsData').textContent);
      var activeFilter = 'all';

      /* ── avatar hydration ── */
      var me = (window.SwapifyAuth && SwapifyAuth.isLoggedIn()) ? SwapifyAuth.currentUser() : null;
      var headerImg = document.getElementById('headerAvatarImg');
      if (headerImg && me && me.avatar) { headerImg.src = me.avatar; }

      /* ── subtitle ── */
      var pendingCount = allSwaps.filter(function(s){ return s.status === 'pending' && s.isIncoming; }).length;
      var subtitle = document.getElementById('srSubtitle');
      if (subtitle) {
        subtitle.textContent = allSwaps.length === 0
          ? 'No swaps yet'
          : allSwaps.length + ' swap' + (allSwaps.length !== 1 ? 's' : '') +
            (pendingCount > 0 ? ' · ' + pendingCount + ' pending action' + (pendingCount !== 1 ? 's' : '') : '');
      }

      /* ── helpers ── */
      function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      function statusBadge(s) {
        var map = {
          pending:   ['#D97706', 'Pending'],
          accepted:  ['var(--success)', 'Accepted'],
          rejected:  ['#ef4444', 'Rejected'],
          completed: ['var(--primary)', 'Completed']
        };
        var c = map[s] || ['var(--muted-fg)', s];
        return '<span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;border:1px solid ' + c[0] + ';color:' + c[0] + '">' + c[1] + '</span>';
      }

      function typeBadge(t) {
        if (t === 'object') {
          return '<span class="sr-type-badge sr-type-object"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>Object Swap</span>';
        }
        return '<span class="sr-type-badge sr-type-skill"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg>Skill Swap</span>';
      }

      /* ── filter ── */
      function filtered() {
        return allSwaps.filter(function(sw) {
          if (activeFilter === 'skill')    return sw.swapType === 'skill';
          if (activeFilter === 'object')   return sw.swapType === 'object';
          if (activeFilter === 'incoming') return sw.isIncoming;
          if (activeFilter === 'outgoing') return !sw.isIncoming;
          if (activeFilter === 'pending')  return sw.status === 'pending';
          if (activeFilter === 'accepted') return sw.status === 'accepted';
          if (activeFilter === 'rejected') return sw.status === 'rejected';
          return true;
        });
      }

      /* ── render ── */
      function render() {
        var list  = document.getElementById('srList');
        var empty = document.getElementById('srEmpty');
        var swaps = filtered();

        if (swaps.length === 0) {
          list.innerHTML = '';
          empty.style.display = '';
          var emptyTitle = document.getElementById('srEmptyTitle');
          var emptyMsg   = document.getElementById('srEmptyMsg');
          if (activeFilter === 'all') {
            emptyTitle.textContent = 'No swap requests yet';
            emptyMsg.textContent   = 'Start exploring the community to find your next great swap!';
          } else {
            emptyTitle.textContent = 'No swaps in this category';
            emptyMsg.textContent   = 'Try a different filter above.';
          }
          return;
        }

        empty.style.display = 'none';
        var html = '<div style="display:flex;flex-direction:column;gap:12px">';

        swaps.forEach(function(sw) {
          var otherName   = sw.isIncoming ? sw.requesterName  : sw.receiverName;
          var otherAvatar = sw.isIncoming ? sw.requesterAvatar : sw.receiverAvatar;
          var otherUserId = sw.isIncoming ? sw.requesterId     : sw.receiverId;
          var dirLabel    = sw.isIncoming ? 'Incoming' : 'Outgoing';
          var actionLabel = sw.isIncoming ? 'wants to swap:' : 'you requested:';
          var avatarSrc   = otherAvatar || DEFAULT_AVA;

          html +=
            '<div class="card card-body" style="display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap">' +
            '<a href="/users/' + escHtml(otherUserId) + '" title="View ' + escHtml(otherName) + '\'s profile" style="flex-shrink:0;display:block;border-radius:50%;overflow:hidden;width:52px;height:52px;text-decoration:none">' +
            '<img src="' + escHtml(avatarSrc) + '" style="width:52px;height:52px;border-radius:50%;object-fit:cover;display:block" onerror="this.src=\'' + DEFAULT_AVA + '\'">' +
            '</a>' +
            '<div style="flex:1;min-width:0">' +
            '<div style="display:flex;align-items:center;flex-wrap:wrap;gap:4px;margin-bottom:4px">' +
            typeBadge(sw.swapType) +
            '<span class="sr-dir-badge">' + dirLabel + '</span>' +
            '</div>' +
            '<p style="margin-bottom:4px"><a href="/users/' + escHtml(otherUserId) + '" style="color:inherit;text-decoration:none;font-weight:700" title="View ' + escHtml(otherName) + '\'s profile">' + escHtml(otherName) + '</a> ' + actionLabel + '</p>' +
            '<p style="font-size:13px;color:var(--muted-fg);margin-bottom:2px">Offers: <strong>' + escHtml(sw.offeredLabel) + '</strong></p>' +
            '<p style="font-size:13px;color:var(--muted-fg);margin-bottom:8px">For: <strong>' + escHtml(sw.requestedLabel) + '</strong></p>' +
            statusBadge(sw.status) +
            '</div>' +
            '<div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end;flex-shrink:0">';

          if (sw.isIncoming && sw.status === 'pending') {
            html +=
              '<form method="POST" action="/swap/' + sw.id + '/accept" style="margin:0">' +
              '<button type="submit" class="btn btn-primary btn-sm">Accept</button></form>' +
              '<form method="POST" action="/swap/' + sw.id + '/reject" style="margin:0">' +
              '<button type="submit" class="btn btn-ghost btn-sm" style="color:#ef4444">Decline</button></form>';
          }
          if (!sw.isIncoming && sw.status === 'pending') {
            html +=
              '<form method="POST" action="/swap/' + sw.id + '/cancel" style="margin:0">' +
              '<button type="submit" class="btn btn-ghost btn-sm" style="color:var(--muted-fg)">Cancel Request</button></form>';
          }

          html += '</div></div>';
        });

        html += '</div>';
        list.innerHTML = html;
      }

      /* ── filter buttons ── */
      document.querySelectorAll('.sr-filter-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.sr-filter-btn').forEach(function(b){ b.classList.remove('active'); });
          btn.classList.add('active');
          activeFilter = btn.dataset.filter;
          render();
        });
      });

      render();

      /* ── Toast from ?action= query param ── */
      (function() {
        var p = new URLSearchParams(window.location.search);
        var a = p.get('action');
        if (a === 'declined')  SwapifyUI.toast('Swap declined.', 'info');
        if (a === 'cancelled') SwapifyUI.toast('Swap request cancelled successfully.', 'success');
        if (a) window.history.replaceState({}, '', '/swap-requests');
      })();
    })();
  </script>
</body>
</html>
